---
import "../styles/tokens.css";
import "../styles/site.css";
import type { SiteCopy } from "../content/types";
import { withBase } from "../lib/url";

interface Props {
  copy: SiteCopy;
  path: string;
  /** An inner page (the articles): its own title and description, its own language pair, its own structured data. */
  page?: {
    meta: { title: string; description: string };
    alternates: { en: string; fr: string };
    jsonLd: Record<string, unknown>;
    /** The Open Graph type: an article by default, a website for the index of the articles. */
    ogType?: "article" | "website";
  };
}

const { copy, path, page } = Astro.props;
const meta = page?.meta ?? copy.meta;
const alternates = page?.alternates ?? { en: "/en/", fr: "/fr/" };
const canonical = new URL(withBase(path), Astro.site).href;
const alt = (p: string) => new URL(withBase(p), Astro.site).href;
const ogImage = alt(`/og/sowel-card-${copy.lang}.png`);
const jsonLd = JSON.stringify(page?.jsonLd ?? {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Sowel",
  applicationCategory: "HomeAutomationApplication",
  operatingSystem: "Linux, macOS, Windows (Docker)",
  description: meta.description,
  url: canonical,
  inLanguage: copy.lang,
  license: "https://www.gnu.org/licenses/agpl-3.0.html",
  codeRepository: "https://github.com/mchacher/sowel",
  image: ogImage,
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
});
const csp =
  "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'none'";
---

<!doctype html>
<html lang={copy.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={alt(alternates.en)} />
    <link rel="alternate" hreflang="fr" href={alt(alternates.fr)} />
    <link rel="alternate" hreflang="x-default" href={alt(alternates.en)} />
    <link rel="icon" href={withBase("/img/logo.svg")} type="image/svg+xml" />
    <meta name="theme-color" content="#0b151b" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b151b" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:type" content={page ? (page.ogType ?? "article") : "website"} />
    <meta property="og:locale" content={copy.lang === "fr" ? "fr_FR" : "en_GB"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Sowel" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={meta.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImage} />
    {!page && <link rel="preload" href={copy.hero.film.poster} as="image" fetchpriority="high" />}
    <script type="application/ld+json" set:html={jsonLd} />
    <link rel="preload" href={withBase("/fonts/inter-latin-wght.woff2")} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <slot />
    <script is:inline>
      (() => {
        // Copy buttons: Clipboard API on click only.
        document.querySelectorAll("[data-copy]").forEach((btn) => {
          const label = btn.querySelector("[data-copy-label]");
          const live = document.getElementById("copy-live");
          btn.addEventListener("click", async () => {
            try {
              await navigator.clipboard.writeText(btn.getAttribute("data-copy"));
              btn.classList.add("is-done");
              if (label) label.textContent = btn.getAttribute("data-done");
              if (live) live.textContent = live.getAttribute("data-msg");
              setTimeout(() => {
                btn.classList.remove("is-done");
                if (label) label.textContent = btn.getAttribute("data-idle");
              }, 2000);
            } catch (e) {}
          });
        });
        // Scroll reveal.
        const els = document.querySelectorAll("[data-reveal]");
        if (!("IntersectionObserver" in window) || matchMedia("(prefers-reduced-motion: reduce)").matches) {
          els.forEach((el) => el.classList.add("is-in"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); } }),
          { rootMargin: "0px 0px -8% 0px" }
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
