---
import type { SiteCopy } from "../content/types";
import Icon from "./Icon.astro";
import Accent from "./Accent.astro";
import SectionTag from "./SectionTag.astro";

interface Props {
  copy: SiteCopy;
}
const { community } = Astro.props.copy;
---

<section class="section community" id={community.id}>
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <SectionTag text={community.eyebrow} icon="messages-square" />
      <h2 class="h2"><Accent text={community.title} accent={community.titleAccent} /></h2>
      <p class="lead">{community.lead}</p>
    </div>
    <ul class="links">
      {
        community.links.map((l, i) => (
          <li data-reveal style={`--delay:${i * 60}ms`}>
            <a class:list={["lk", { "lk--tile": i === 0 }]} href={l.href}>
              <span class="lk__tile">
                <Icon name={l.icon} class="icon" />
              </span>
              <span class="lk__text">
                <strong>{l.title}</strong>
                <span>{l.body}</span>
              </span>
              <Icon name="arrow-right" class="icon lk__arrow" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Follows Install on the same ground: one gap between them, not two. */
  .community {
    padding-top: clamp(24px, 3vw, 40px);
  }
  .links {
    margin-top: clamp(32px, 4vw, 44px);
    display: grid;
    gap: 14px;
  }
  @media (min-width: 640px) {
    .links {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }
  @media (min-width: 1100px) {
    .links {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .lk {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 18px 18px 18px;
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .lk:hover {
    color: inherit;
    border-color: var(--accent-mark);
  }
  /* The saturated block of the section: the code itself. */
  .lk--tile {
    --text-strong: var(--tile-text);
    --text-3: var(--tile-text-2);
    background: var(--tile);
    border-color: transparent;
    box-shadow: var(--shadow-tile);
  }
  .lk--tile:hover {
    border-color: var(--accent);
  }
  .lk--tile .lk__tile {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }
  .lk--tile .lk__arrow,
  .lk--tile:hover .lk__arrow {
    color: #fff;
  }
  .lk__tile {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: var(--r-md);
    background: var(--p-50);
    color: var(--accent-ink);
  }
  .lk__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.4;
  }
  .lk__text strong {
    font-size: 16px;
    font-weight: 650;
    color: var(--text-strong);
  }
  .lk__text span {
    font-size: 14px;
    color: var(--text-3);
  }
  .lk__arrow {
    margin-left: auto;
    width: 18px;
    height: 18px;
    color: var(--text-3);
    transition: transform 0.15s ease, color 0.15s ease;
  }
  .lk:hover .lk__arrow {
    transform: translateX(3px);
    color: var(--accent-ink);
  }
</style>
