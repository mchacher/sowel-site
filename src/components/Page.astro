---
import Base from "../layouts/Base.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Home from "./Home.astro";
import Rooms from "./Rooms.astro";
import Dashboard from "./Dashboard.astro";
import Recipes from "./Recipes.astro";
import Energy from "./Energy.astro";
import Modes from "./Modes.astro";
import Privacy from "./Privacy.astro";
import Articles from "./Articles.astro";
import Install from "./Install.astro";
import Community from "./Community.astro";
import Footer from "./Footer.astro";
import SectionNav from "./SectionNav.astro";
import type { SiteCopy } from "../content/types";

interface Props {
  copy: SiteCopy;
  path: string;
}
const { copy, path } = Astro.props;
---

<Base copy={copy} path={path}>
  <Header copy={copy} />
  <main id="main">
    <Hero copy={copy} />
    <Home copy={copy} />
    <Rooms copy={copy} />
    <Dashboard copy={copy} />
    <Recipes copy={copy} />
    <Modes copy={copy} />
    <Energy copy={copy} />
    <Privacy copy={copy} />
    <Articles copy={copy} />
    <Install copy={copy} />
    <Community copy={copy} />
  </main>
  <SectionNav copy={copy} />
  <Footer copy={copy} />
  <p id="copy-live" class="sr-only" aria-live="polite" data-msg={copy.a11y.copyDone}></p>
</Base>
