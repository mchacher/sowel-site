---
import type { SiteCopy } from "../content/types";

interface Props {
  copy: SiteCopy;
}
const { compare } = Astro.props.copy;
const [, colSowel, colHa, colJeedom] = compare.columns;
---

<section class="section section--band" id={compare.id}>
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{compare.eyebrow}</p>
      <h2 class="h2">{compare.title}</h2>
      <p class="lead">{compare.lead}</p>
    </div>

    <p class="draft" data-reveal>
      <span class="draft__tag">{compare.placeholder}</span>
      {compare.draftNote}
    </p>

    <div class="tablewrap" data-reveal>
      <table>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">{compare.columns[0]}</span></th>
            <th scope="col" class="is-sowel">{colSowel}</th>
            <th scope="col">{colHa}</th>
            <th scope="col">{colJeedom}</th>
          </tr>
        </thead>
        <tbody>
          {
            compare.rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                <td class="is-sowel" data-col={colSowel}>{r.sowel}</td>
                <td data-col={colHa}>
                  <span class="ph">{compare.placeholder}</span>
                </td>
                <td data-col={colJeedom}>
                  <span class="ph">{compare.placeholder}</span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="checked">{compare.checkedOn}</p>
  </div>
</section>

<style>
  .draft {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
    font-size: 14px;
    color: var(--text-3);
  }
  .draft__tag {
    padding: 3px 10px;
    border-radius: 999px;
    border: 1px dashed var(--border-strong);
    font-weight: 600;
    color: var(--text-2);
  }
  .tablewrap {
    margin-top: 20px;
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    line-height: 1.5;
  }
  th,
  td {
    padding: 18px 20px;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--border);
  }
  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }
  thead th {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-3);
    background: var(--bg-band);
  }
  thead th.is-sowel {
    color: var(--p-500);
  }
  tbody th {
    width: 20%;
    font-weight: 600;
    color: var(--text-strong);
  }
  td {
    width: 26.6%;
    color: var(--text-2);
  }
  td.is-sowel {
    background: color-mix(in srgb, var(--p-50) 55%, transparent);
    color: var(--text-strong);
  }
  .ph {
    display: inline-flex;
    align-items: center;
    height: 26px;
    padding: 0 10px;
    border-radius: var(--r-sm);
    border: 1px dashed var(--border-strong);
    font-size: 13px;
    color: var(--text-3);
  }
  .checked {
    margin-top: 14px;
    font-size: 13px;
    color: var(--text-3);
  }

  /* Phone: each row becomes a block, each product a labelled line */
  @media (max-width: 719px) {
    thead {
      display: none;
    }
    table,
    tbody,
    tr,
    th,
    td {
      display: block;
      width: 100%;
    }
    tbody tr {
      padding: 18px 18px 14px;
      border-bottom: 1px solid var(--border);
    }
    tbody tr:last-child {
      border-bottom: 0;
    }
    tbody th,
    td {
      padding: 0;
      border: 0;
    }
    tbody th {
      width: auto;
      margin-bottom: 10px;
      font-size: 16px;
    }
    td {
      display: grid;
      grid-template-columns: 112px 1fr;
      gap: 12px;
      align-items: center;
      padding: 7px 0;
      background: none !important;
    }
    td::before {
      content: attr(data-col);
      font-size: 13px;
      font-weight: 600;
      color: var(--text-3);
    }
    td.is-sowel::before {
      color: var(--p-500);
    }
    .ph {
      justify-self: start;
    }
  }
</style>
