---
import Base from "../layouts/Base.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import SectionTag from "./SectionTag.astro";
import Highlight from "./Highlight.astro";
import Diagram from "./Diagram.astro";
import Scheme from "./Scheme.astro";
import type { SiteCopy } from "../content/types";
import type { Article, Block, Run } from "../content/articles/types";
import { withBase } from "../lib/url";
import { formatDate, headingIds, readingMinutes } from "../lib/article";
import { indexPath, pathStep } from "../content/articles/index.ts";

interface Props {
  copy: SiteCopy;
  article: Article;
}
const { copy, article } = Astro.props;
const ui = copy.articlePage;
const abs = (p: string) => new URL(withBase(p), Astro.site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.title,
  description: article.meta.description,
  author: { "@type": "Person", name: "Marc Chachereau" },
  publisher: { "@type": "Organization", name: "Sowel", url: abs("/en/") },
  inLanguage: article.lang,
  datePublished: article.datePublished,
  mainEntityOfPage: abs(article.path),
  image: abs(`/og/sowel-card-${article.lang}.png`),
};
const alternates =
  article.lang === "en"
    ? { en: article.path, fr: article.otherPath }
    : { en: article.otherPath, fr: article.path };

// The first paragraph is the standfirst: set in the header, larger, and not repeated below.
const first = article.blocks[0];
const lead = first?.kind === "p" ? first : undefined;
const body = article.blocks.map((b, i) => ({ b, i })).filter(({ i }) => !(lead && i === 0));

const ids = headingIds(article);
const toc = article.blocks
  .filter((b): b is Extract<Block, { kind: "h2" }> => b.kind === "h2")
  .map((b, n) => ({ id: ids[n], text: b.text }));
let h = 0;
const nextId = () => ids[h++];

const minutes = readingMinutes(article);
const date = formatDate(article.datePublished, article.lang);
// The byline reads as a label in the byline row: its closing full stop is left out.
// A paragraph's runs: text, bold, or a link (spec 003). A list item: text, or a bold lead and its text.
const isLink = (r: Run): r is { link: string; href: string } => "link" in r;
const byline = article.byline.replace(/\.\s*$/, "");
// The reading path: the step shows in the byline, and the card to the next step comes just before the closing links.
const step = pathStep(article.lang, article.path);
const stepText = step && ui.step.replace("{n}", String(step.n)).replace("{total}", String(step.total));
const hasLinks = body.some(({ b }) => b.kind === "links");
---

<Base
  copy={copy}
  path={article.path}
  page={{ meta: article.meta, alternates, jsonLd }}
>
  <Header copy={copy} inner={{ home: `/${article.lang}/`, switchHref: withBase(article.otherPath), current: article.path }} />
  <div class="progress" aria-hidden="true"></div>
  <main id="main" class="article">
    <div class="article__grid">
      <header class="article__head">
        <nav class="crumbs" aria-label={ui.breadcrumb.label}>
          <ol>
            <li><a href={withBase(`/${article.lang}/`)}>{ui.breadcrumb.home}</a></li>
            <li><a href={withBase(`/${article.lang}/articles/`)} data-crumb-index>{ui.breadcrumb.articles}</a></li>
            <li class="crumbs__here" aria-current="page">{article.title}</li>
          </ol>
        </nav>
        <SectionTag text={ui.eyebrow} icon="newspaper" small />
        <h1 class="article__title">{article.title}</h1>
        {
          lead && (
            <p class="standfirst">
              {lead.runs.map((r) => (isLink(r) ? <a class="inline" href={r.href}>{r.link}</a> : "bold" in r ? <strong>{r.bold}</strong> : "code" in r ? <code>{r.code}</code> : r.text))}
            </p>
          )
        }
        <div class="byline">
          <span class="byline__avatar" aria-hidden="true"><Logo size={26} /></span>
          <div>
            <p class="byline__name">{byline}</p>
            <p class="byline__meta">
              <span><Icon name="calendar" class="icon byline__icon" /><time datetime={article.datePublished}>{date}</time></span>
              <span data-reading-time={minutes}><Icon name="clock" class="icon byline__icon" />{ui.readingTime.replace("{n}", String(minutes))}</span>
              {step && <a class="byline__step" href={withBase(`${indexPath(article.lang)}#start`)} data-path-step={step.n}><Icon name="list-ordered" class="icon byline__icon" />{stepText}</a>}
            </p>
          </div>
        </div>
        <details class="toc-m">
          <summary><span>{ui.toc}</span><Icon name="chevron-down" class="icon toc-m__chev" /></summary>
          <nav aria-label={ui.toc}>
            <ol class="toc__list">
              {toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}
            </ol>
          </nav>
        </details>
      </header>

      <aside class="toc">
        <nav aria-labelledby="toc-title" data-toc>
          <p class="toc__title" id="toc-title">{ui.toc}</p>
          <ol class="toc__list">
            {toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}
          </ol>
        </nav>
      </aside>

      <div class="prose">
        {
          body.map(({ b, i }) => {
            if (b.kind === "p")
              return <p>{b.runs.map((r) => (isLink(r) ? <a class="inline" href={r.href}>{r.link}</a> : "bold" in r ? <strong>{r.bold}</strong> : "code" in r ? <code>{r.code}</code> : r.text))}</p>;
            if (b.kind === "h2") {
              const id = nextId();
              return (
                <div class="sec">
                  <h2 id={id}>{b.text}</h2>
                  <a class="sec__anchor" href={`#${id}`} aria-label={ui.anchor.replace("{h}", b.text)} />
                </div>
              );
            }
            if (b.kind === "list")
              return (
                <ul class={b.items.some((t) => typeof t !== "string") ? "list list--lead" : "list"}>
                  {b.items.map((t) => (typeof t === "string" ? <li>{t}</li> : <li><strong>{t.lead}</strong> {t.text}</li>))}
                </ul>
              );
            if (b.kind === "links") {
              const [primary, ...quiet] = b.items;
              return (
                <>
                {step?.next && (
                <a class="next" href={step.next.href} data-path-next={step.next.path}>
                  <span class="next__label">{ui.next}</span>
                  <span class="next__title">{step.next.title}</span>
                  <Icon name="arrow-right" class="icon next__arrow" />
                </a>
              )}
                <ul class="cta">
                  {primary && (
                    <li class="cta__primary">
                      <a class="btn btn--fill" href={primary.href}>
                        {primary.label}
                        <Icon name="arrow-right" class="icon cta__arrow" />
                      </a>
                    </li>
                  )}
                  {quiet.map((l) => (
                    <li>
                      <a class="cta__link" href={l.href}>
                        <span>{l.label}</span>
                        <Icon name="arrow-right" class="icon cta__arrow" />
                      </a>
                    </li>
                  ))}
                </ul>
                </>
              );
            }
            if (b.kind === "highlight") return <Highlight block={b} />;
            if (b.kind === "diagram") return <Diagram block={b} uid={`dg-${i}`} />;
            if (
              b.kind === "topology" ||
              b.kind === "pipeline" ||
              b.kind === "form" ||
              b.kind === "layers" ||
              b.kind === "knowledge" ||
              b.kind === "chain" ||
              b.kind === "stack"
            )
              return <Scheme block={b} uid={`sc-${i}`} />;
            if (b.kind === "pull")
              return (
                <blockquote class="pull">
                  <Icon name="quote" class="icon pull__mark" />
                  <p>{b.text}</p>
                </blockquote>
              );
            return (
              <figure class={`fig fig--${b.id}`}>
                <div
                  class="fig__well"
                  role={b.id === "arbiter" ? "region" : undefined}
                  tabindex={b.id === "arbiter" ? 0 : undefined}
                  aria-labelledby={b.id === "arbiter" ? `cap-${i}` : undefined}
                >
                  <img
                    src={b.image.src}
                    alt={b.image.alt}
                    width={b.image.width}
                    height={b.image.height}
                    decoding="async"
                    loading={i < 4 ? "eager" : "lazy"}
                  />
                </div>
                <figcaption id={`cap-${i}`}>{b.caption}</figcaption>
              </figure>
            );
          })
        }
        {
          step?.next && !hasLinks && (
                <a class="next" href={step.next.href} data-path-next={step.next.path}>
                  <span class="next__label">{ui.next}</span>
                  <span class="next__title">{step.next.title}</span>
                  <Icon name="arrow-right" class="icon next__arrow" />
                </a>
              )
        }
      </div>
    </div>
  </main>
  <Footer copy={copy} />
  <script is:inline>
    (() => {
      // The contents follow the reading: the last heading above the upper third of the window is the current one.
      const nav = document.querySelector("[data-toc]");
      if (!nav || !("IntersectionObserver" in window)) return;
      const links = new Map([...nav.querySelectorAll("a")].map((a) => [a.getAttribute("href").slice(1), a]));
      const heads = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean);
      const update = () => {
        const line = innerHeight * 0.35;
        let current = null;
        for (const el of heads) if (el.getBoundingClientRect().top < line) current = el.id;
        links.forEach((a, id) => (id === current ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current")));
      };
      const io = new IntersectionObserver(update, { rootMargin: "0px 0px -65% 0px" });
      heads.forEach((el) => io.observe(el));
      update();
    })();
  </script>
</Base>

<style>
  .article {
    --col: 45rem; /* about 77 characters of Inter at 17px */
    --wide: 58rem;
    padding-block: clamp(28px, 4.5vw, 56px) clamp(64px, 8vw, 104px);
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .article__grid {
    padding-inline: var(--gutter);
  }
  .article__head,
  .prose > * {
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
  }

  /* The reading progress: a thin blue line along the foot of the night header, driven by the scroll itself. */
  .progress {
    display: none;
  }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .progress {
        display: block;
        position: fixed;
        top: 62px;
        left: 0;
        right: 0;
        z-index: 51;
        height: 3px;
        background: linear-gradient(90deg, var(--stage-fill), var(--accent));
        transform-origin: 0 50%;
        transform: scaleX(0);
        animation: read-progress linear both;
        animation-timeline: scroll(root block);
        pointer-events: none;
      }
    }
  }
  @keyframes read-progress {
    to {
      transform: scaleX(1);
    }
  }

  /* The header of the article: breadcrumb, tag, title, standfirst, byline. */
  .crumbs ol {
    display: flex;
    gap: 6px;
    min-width: 0;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--text-3);
  }
  .crumbs li {
    flex: none;
    white-space: nowrap;
  }
  /* The article's title ends the trail, cut with an ellipsis when the line is too short for it. */
  .crumbs .crumbs__here {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .crumbs li + li::before {
    content: "/" / "";
    margin-right: 6px;
    color: var(--border-strong);
  }
  .crumbs a {
    color: var(--text-2);
    border-radius: 3px;
  }
  .crumbs a:hover {
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .article__head :global(.section-tag) {
    margin-top: 22px;
  }
  .article__title {
    margin-top: 18px;
    font-size: clamp(1.875rem, 1.45rem + 1.8vw, 2.5rem);
    line-height: 1.12;
    font-weight: 720;
    letter-spacing: -0.028em;
    color: var(--text-strong);
    text-wrap: balance;
  }
  .standfirst {
    margin-top: 18px;
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--text-strong);
    text-wrap: pretty;
  }
  .byline {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 28px;
    padding-block: 18px;
    border-block: 1px solid var(--border);
  }
  .byline__avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background:
      radial-gradient(80% 80% at 50% 100%, color-mix(in srgb, var(--accent) 28%, transparent), transparent 70%),
      var(--p-50);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent-mark) 30%, transparent);
  }
  .byline__name {
    font-size: 0.9375rem;
    line-height: 1.4;
    font-weight: 600;
    color: var(--text-strong);
  }
  .byline__meta {
    display: flex;
    flex-wrap: wrap;
    column-gap: 18px;
    row-gap: 2px;
    margin-top: 3px;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-3);
  }
  .byline__meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }
  .byline__meta :global(.byline__icon) {
    width: 15px;
    height: 15px;
  }

  /* Contents: a sticky side column on wide screens, a folded panel under the byline below. */
  .toc {
    display: none;
  }
  .toc__title {
    font-size: 0.8125rem;
    font-weight: 650;
    color: var(--text-3);
  }
  .toc__list {
    display: grid;
    gap: 2px;
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .toc__list a {
    display: block;
    padding: 6px 10px 6px 14px;
    border-left: 2px solid var(--border);
    color: var(--text-2);
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .toc__list a:hover {
    color: var(--text-strong);
    border-left-color: var(--border-strong);
  }
  .toc__list a[aria-current] {
    color: var(--accent-ink);
    font-weight: 600;
    border-left-color: var(--accent-mark);
  }
  .toc-m {
    margin-top: 16px;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
  }
  .toc-m summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-strong);
    cursor: pointer;
    list-style: none;
    border-radius: var(--r-md);
  }
  .toc-m summary::-webkit-details-marker {
    display: none;
  }
  .toc-m :global(.toc-m__chev) {
    width: 18px;
    height: 18px;
    color: var(--text-3);
    transition: transform 0.2s ease;
  }
  .toc-m[open] :global(.toc-m__chev) {
    transform: rotate(180deg);
  }
  .toc-m nav {
    padding: 0 16px 14px;
  }

  /* The text. */
  .prose {
    margin-top: clamp(32px, 4vw, 44px);
  }
  .prose > * + * {
    margin-top: 1.15em;
  }
  .prose p,
  .prose li {
    color: var(--text);
    text-wrap: pretty;
  }
  .prose strong {
    font-weight: 650;
    color: var(--text-strong);
  }
  .prose > .sec {
    position: relative;
    margin-top: 2.9rem;
  }
  .sec h2 {
    font-size: clamp(1.35rem, 1.25rem + 0.4vw, 1.5rem);
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-strong);
    text-wrap: balance;
  }
  .prose > .sec + * {
    margin-top: 0.7em;
  }
  /* A heading's anchor: a small # in the margin, shown on hover and on focus. */
  .sec__anchor {
    position: absolute;
    top: 0.15em;
    left: -1.15em;
    width: 1em;
    font-size: 1.125rem;
    line-height: 1.6;
    font-weight: 600;
    text-align: center;
    color: var(--accent-mark);
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .sec__anchor::before {
    content: "#";
  }
  .sec:hover .sec__anchor,
  .sec__anchor:focus-visible {
    opacity: 1;
  }

  .list {
    display: grid;
    gap: 0.55em;
  }
  .list li {
    position: relative;
    padding-left: 1.6em;
  }
  .list li::before {
    content: "";
    position: absolute;
    left: 0.3em;
    top: 0.72em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-mark);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-mark) 18%, transparent);
  }

  /* The exergue: the key sentence, a little wider than the text, with a rule and a quotation mark. */
  .prose > .pull {
    max-width: min(50rem, 100%);
    margin-block: 2.6rem;
    padding: 4px 0 4px clamp(18px, 3vw, 28px);
    border-left: 3px solid var(--accent-mark);
  }
  .pull :global(.pull__mark) {
    width: 34px;
    height: 34px;
    margin-bottom: 8px;
    color: color-mix(in srgb, var(--accent-mark) 45%, transparent);
  }
  .pull p {
    font-size: clamp(1.4rem, 1.05rem + 1.3vw, 2rem);
    line-height: 1.18;
    font-weight: 730;
    letter-spacing: -0.025em;
    color: var(--accent-ink);
    text-wrap: balance;
  }

  /* The highlight: as wide as the exergue (its own look lives in Highlight.astro). */
  .prose > :global(.hl) {
    width: 100%;
    max-width: min(50rem, 100%);
    margin: 2.4rem auto;
  }

  /* Figures: the captures on the home page's soft well, a small muted caption under. */
  .prose > :global(.fig) {
    margin-block: 2.2rem;
  }
  .prose :global(.fig__well) {
    padding: clamp(14px, 2.4vw, 24px);
    border-radius: var(--r-lg);
    border: 1px solid var(--border);
    background:
      radial-gradient(70% 55% at 50% 100%, color-mix(in srgb, var(--accent) 20%, transparent), transparent 72%),
      var(--n-50);
  }
  .fig img {
    width: 100%;
    height: auto;
    border-radius: var(--r-md);
    box-shadow: 0 0 0 1px var(--border), 0 18px 36px -20px rgba(17, 23, 27, 0.32);
    filter: var(--img-dim);
  }
  .prose :global(.fig figcaption) {
    margin-top: 10px;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-3);
    text-wrap: pretty;
  }
  /* A scheme is rendered by Scheme.astro, so the column rule above does not reach it: it takes the column here. */
  .prose > :global(.scheme) {
    width: 100%;
    max-width: var(--col);
    margin-inline: auto;
  }
  .prose > .fig--arbiter,
  .prose > .fig--devices,
  .prose > .fig--room,
  .prose > :global(.scheme--pipeline),
  .prose > :global(.scheme--layers),
  .prose > :global(.scheme--knowledge),
  .prose > :global(.scheme--chain),
  .prose > :global(.scheme--stack) {
    max-width: min(var(--wide), 100%);
  }
  /* A raw name inside a paragraph (spec 004), as the network spells it. */
  .prose p code,
  .standfirst code {
    font-family: var(--mono);
    font-size: 0.82em;
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--n-50);
    color: var(--text-2);
    overflow-wrap: anywhere;
  }
  /* A tall phone-width capture (spec 003): kept narrow and centred on its well. */
  .fig--activity img {
    display: block;
    max-width: 26rem;
    margin-inline: auto;
  }
  /* A link inside a paragraph (spec 003). */
  .standfirst .inline,
  .prose .inline {
    color: var(--accent-ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent-mark) 45%, transparent);
    text-underline-offset: 3px;
  }
  .standfirst .inline:hover,
  .prose .inline:hover {
    text-decoration-color: currentColor;
  }
  /* Bullets that open on a bold lead get a little more air (spec 003). */
  .list--lead {
    gap: 0.8em;
  }
  @media (max-width: 959px) {
    .fig--arbiter .fig__well {
      overflow-x: auto;
    }
    .fig--arbiter img {
      width: 720px;
      max-width: none;
    }
  }

  /* The byline's step on the reading path: a quiet link to the path at the top of the index. */
  .byline__step {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    color: var(--text-2);
    border-radius: 3px;
  }
  .byline__step:hover {
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* The next step of the reading path: one link, its label above the title of the next article. */
  .prose > .next {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: 16px;
    row-gap: 4px;
    align-items: center;
    margin-top: 2rem;
    padding: clamp(18px, 2.6vw, 22px) clamp(20px, 3vw, 28px);
    border-radius: var(--r-lg);
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .prose > .next:hover {
    color: inherit;
    border-color: var(--border-strong);
    box-shadow: 0 1px 2px rgba(15, 42, 60, 0.05), 0 18px 36px -18px rgba(15, 42, 60, 0.28);
  }
  .prose > .next:focus-visible {
    outline: 2px solid var(--accent-mark);
    outline-offset: 4px;
  }
  .next__label {
    grid-column: 1;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-3);
  }
  .next__title {
    grid-column: 1;
    font-size: clamp(1.125rem, 1.05rem + 0.3vw, 1.25rem);
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--text-strong);
    text-wrap: balance;
  }
  .next:hover .next__title {
    color: var(--accent-ink);
