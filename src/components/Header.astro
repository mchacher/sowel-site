---
import type { SiteCopy } from "../content/types";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";

interface Props {
  copy: SiteCopy;
}
const { copy } = Astro.props;
---

<a class="skip" href="#main">{copy.a11y.skip}</a>
<header class="header">
  <div class="container header__inner">
    <a class="brand" href="#top" aria-label={copy.a11y.home}>
      <Logo size={30} />
      <span class="brand__word">sowel</span>
    </a>
    <nav class="nav" aria-label={copy.a11y.nav}>
      {copy.nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="header__actions">
      <a class="lang" href={copy.nav.switch.href} hreflang={copy.nav.switch.lang} lang={copy.nav.switch.lang} aria-label={copy.nav.switch.aria}>{copy.nav.switch.label}</a>
      <a class="gh" href={copy.nav.github.href}>
        <Icon name="git-fork" class="icon icon--sm" />
        <span>{copy.nav.github.label}</span>
      </a>
      <a class="btn btn--fill btn--sm" href={copy.hero.ctas.primary.href}>{copy.hero.ctas.primary.label}</a>
    </div>
  </div>
</header>

<style>
  .skip {
    position: absolute;
    left: 12px;
    top: -48px;
    z-index: 100;
    padding: 8px 12px;
    border-radius: var(--r-sm);
    background: var(--p-fill);
    color: #fff;
  }
  .skip:focus {
    top: 12px;
  }
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--p-500);
  }
  .brand__word {
    font-size: 21px;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--p-500);
    transform: translateY(-1px);
  }
  .nav {
    display: none;
    gap: 4px;
  }
  .nav a {
    padding: 8px 12px;
    border-radius: var(--r-sm);
    font-size: 15px;
    font-weight: 500;
    color: var(--text-2);
  }
  .nav a:hover {
    color: var(--text-strong);
    background: var(--surface-sunk);
  }
  .header__actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .lang {
    display: inline-flex;
    align-items: center;
    height: 38px;
    padding-inline: 10px;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text-2);
  }
  .lang:hover {
    color: var(--text-strong);
    border-color: var(--text-3, var(--border));
  }
  .gh {
    display: none;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    font-size: 15px;
    font-weight: 500;
    color: var(--text-2);
  }
  .gh:hover {
    color: var(--text-strong);
  }
  .icon--sm {
    width: 18px;
    height: 18px;
  }
  .btn--sm {
    height: 38px;
    padding-inline: 16px;
    font-size: 14px;
  }
  @media (min-width: 640px) {
    .gh {
      display: inline-flex;
    }
  }
  @media (min-width: 1024px) {
    .nav {
      display: flex;
    }
  }
</style>
