---
import type { SiteCopy } from "../content/types";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { withBase } from "../lib/url";
import { indexPath, menuLinks } from "../content/articles/index.ts";
import { tutorialLinks } from "../content/tutorials/index.ts";

interface Props {
  copy: SiteCopy;
  /**
   * On an inner page: the home page of the language (section anchors lead back to it), the other-language twin of
   * this page, and its own path when it is an article or the index (its entry in the Docs menu is then the current
   * page).
   */
  inner?: { home: string; switchHref: string; current?: string };
}
const { copy, inner } = Astro.props;
const to = (hash: string) => (inner ? withBase(inner.home) + hash : hash);
const switchHref = inner?.switchHref ?? copy.nav.switch.href;
const docs = copy.nav.docs;
// The menu shows the most recent articles only; the « All articles » row leads to the index and the rest.
const arts = menuLinks(copy.lang);
const index = indexPath(copy.lang);
// The tutorials (spec 005), all of them, in reading order.
const tuts = tutorialLinks(copy.lang);
// Two levels (spec 005): the rail names the groups, the pane shows one. It opens on the group of the current page.
const groups = [
  { id: "articles", label: docs.articles, icon: "newspaper" as const },
  ...(tuts.length ? [{ id: "tutorials", label: docs.tutorials, icon: "graduation-cap" as const }] : []),
  { id: "manual", label: docs.manual, icon: "book-open" as const },
];
const activeGroup = tuts.some((t) => t.path === inner?.current) ? "tutorials" : "articles";
const readingTime = (n: number) => copy.articlePage.readingTime.replace("{n}", String(n));
---

<a class="skip" href="#main">{copy.a11y.skip}</a>
<header class="header">
  <div class="container header__inner">
    <a class="brand" href={to("#top")} aria-label={copy.a11y.home}>
      <Logo size={30} />
      <span class="brand__word">sowel</span>
    </a>
    <nav class="nav" aria-label={copy.a11y.nav}>
      {copy.nav.links.map((l) => <a href={to(l.href)}>{l.label}</a>)}
    </nav>
    <div class="header__actions">
      <a class="lang" href={switchHref} hreflang={copy.nav.switch.lang} lang={copy.nav.switch.lang} aria-label={copy.nav.switch.aria}>{copy.nav.switch.label}</a>
      <!-- The Docs menu (spec 002): a disclosure, a details element so it opens without script; the script below only
           adds Escape, a click outside and focus leaving it to the ways it closes. -->
      <details class="docs" data-docs>
        <summary class="docs__btn" aria-controls="docs-panel">
          <Icon name="book-open" class="icon icon--sm" />
          <span class="docs__label">{docs.label}</span>
          <Icon name="chevron-down" class="icon docs__chev" />
        </summary>
        <nav class="docs__panel" id="docs-panel" aria-label={docs.menu} data-docs-panel data-active={activeGroup}>
          <!-- The rail: shown once the script runs; without it, the three groups stay stacked. -->
          <div class="docs__rail" data-docs-rail>
            {
              groups.map((g) => (
                <button class="docs__tab" type="button" aria-controls={`docs-sec-${g.id}`} data-docs-tab={g.id}>
                  <Icon name={g.icon} class="icon docs__tab-i" />
                  <span>{g.label}</span>
                  <Icon name="chevron-right" class="icon docs__tab-chev" />
                </button>
              ))
            }
          </div>
          <div class="docs__panes">
          <section class="docs__sec" id="docs-sec-articles" data-docs-sec="articles">
          <p class="docs__group" id="docs-g-articles">{docs.articles}</p>
          <ul class="docs__list" aria-labelledby="docs-g-articles">
            {
              arts.map((a) => (
                <li>
                  <a
                    class="docs__item docs__item--article"
                    href={a.href}
                    aria-current={inner?.current === a.path ? "page" : undefined}
                    data-docs-article
                  >
                    <span class="docs__medal" aria-hidden="true">
                      <Icon name="newspaper" class="icon docs__icon" />
                    </span>
                    <span class="docs__text">
                      <span class="docs__title">{a.title}</span>
                      <span class="docs__desc">{readingTime(a.minutes)}</span>
                    </span>
                  </a>
                </li>
              ))
            }
            <li>
              <a
                class="docs__all"
                href={withBase(index)}
                aria-current={inner?.current === index ? "page" : undefined}
                data-docs-all
              >
                <span>{docs.all}</span>
                <Icon name="arrow-right" class="icon docs__arrow" />
              </a>
            </li>
          </ul>
          </section>
          {
            tuts.length > 0 && (
              <section class="docs__sec" id="docs-sec-tutorials" data-docs-sec="tutorials">
                <p class="docs__group" id="docs-g-tutorials">{docs.tutorials}</p>
                <ul class="docs__list" aria-labelledby="docs-g-tutorials">
                  {tuts.map((a) => (
                    <li>
                      <a class="docs__item" href={a.href} aria-current={inner?.current === a.path ? "page" : undefined} data-docs-tutorial>
                        <span class="docs__medal" aria-hidden="true">
                          <Icon name="graduation-cap" class="icon docs__icon" />
                        </span>
                        <span class="docs__text">
                          <span class="docs__title">{a.title}</span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }
          <section class="docs__sec" id="docs-sec-manual" data-docs-sec="manual">
          <p class="docs__group" id="docs-g-manual">{docs.manual}</p>
          <ul class="docs__list" aria-labelledby="docs-g-manual">
            {
              docs.links.map((l) => (
                <li>
                  <a class="docs__item" href={l.href} data-docs-manual>
                    <span class="docs__medal" aria-hidden="true">
                      <Icon name={l.icon} class="icon docs__icon" />
                    </span>
                    <span class="docs__text">
                      <span class="docs__title">{l.title}</span>
                      <span class="docs__desc">{l.body}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
          </section>
          </div>
        </nav>
      </details>
      <a class="gh" href={copy.nav.github.href} aria-label={copy.nav.github.label}>
        <Icon name="git-fork" class="icon icon--sm" />
        <span class="gh__label">{copy.nav.github.label}</span>
      </a>
      <a class="btn btn--fill btn--sm" href={to(copy.hero.ctas.primary.href)}>{copy.hero.ctas.primary.label}</a>
    </div>
  </div>
</header>
<script is:inline>
  (() => {
    const d = document.querySelector("[data-docs]");
    if (!d) return;
    const s = d.querySelector("summary");
    const sync = () => s.setAttribute("aria-expanded", d.open ? "true" : "false");
    sync();
    d.addEventListener("toggle", sync);
    d.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && d.open) {
        d.open = false;
        s.focus();
      }
    });
    document.addEventListener("click", (e) => {
      if (d.open && !d.contains(e.target)) d.open = false;
    });
    // Two levels: the rail switches the pane, on hover with a mouse, on a click or a tap otherwise.
    const panel = d.querySelector("[data-docs-panel]");
    d.classList.add("docs--tabs");
    const show = (id) => {
      panel.dataset.active = id;
      panel.querySelectorAll("[data-docs-tab]").forEach((t) => t.setAttribute("aria-pressed", t.dataset.docsTab === id ? "true" : "false"));
    };
    show(panel.dataset.active);
    panel.querySelectorAll("[data-docs-tab]").forEach((t) => {
      t.addEventListener("click", () => show(t.dataset.docsTab));
      // A short pause before switching on hover, so a diagonal move towards an entry does not cross onto another group.
      let timer;
      t.addEventListener("pointerenter", (e) => {
        if (e.pointerType !== "mouse") return;
        clearTimeout(timer);
        timer = setTimeout(() => show(t.dataset.docsTab), 120);
      });
      t.addEventListener("pointerleave", () => clearTimeout(timer));
    });
    // A keyboard user tabs through every entry: the pane follows the focus.
    panel.addEventListener("focusin", (e) => {
      const sec = e.target.closest("[data-docs-sec]");
      if (sec) show(sec.dataset.docsSec);
    });
    d.addEventListener("focusout", (e) => {
      if (d.open && e.relatedTarget && !d.contains(e.relatedTarget)) d.open = false;
    });
  })();
</script>

<style>
  .skip {
    position: absolute;
    left: 12px;
    top: -48px;
    z-index: 100;
    padding: 8px 12px;
    border-radius: var(--r-sm);
    background: var(--p-fill);
    color: #fff;
  }
  .skip:focus {
    top: 12px;
  }
  /* The header belongs to the night stage, in both themes. */
  .header {
    --p-500: #f3f7fa;
    --text-2: #b9cfdc;
    --text-3: #8eabbd;
    --text-strong: #ffffff;
    --surface-sunk: rgba(255, 255, 255, 0.06);
    --border: rgba(169, 195, 211, 0.2);
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--stage);
    border-bottom: 1px solid rgba(169, 195, 211, 0.08);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--accent);
  }
  .brand__word {
    font-size: 21px;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: #fff;
    transform: translateY(-1px);
  }
  .nav {
    display: none;
    gap: 4px;
  }
  .nav a {
    padding: 8px 10px;
    white-space: nowrap;
    border-radius: var(--r-sm);
    font-size: 15px;
    font-weight: 500;
    color: var(--text-2);
  }
  .nav a:hover {
    color: var(--text-strong);
    background: var(--surface-sunk);
  }
  .header__actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .lang {
    display: inline-flex;
    align-items: center;
    height: 38px;
    padding-inline: 10px;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text-2);
  }
  .lang:hover {
    color: var(--text-strong);
    border-color: var(--text-3, var(--border));
  }
  .gh {
    display: none;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    font-size: 15px;
    font-weight: 500;
    color: var(--text-2);
  }
  .gh:hover {
    color: var(--text-strong);
  }
  .icon--sm {
    width: 18px;
    height: 18px;
  }
  .btn--sm {
    height: 38px;
    padding-inline: 16px;
    font-size: 14px;
    background: var(--stage-fill);
  }
  .btn--sm:hover {
    background: var(--stage-fill-hover);
  }
  /* The Docs menu: a button on the night stage, a night card under it. */
  .docs {
    position: relative;
  }
  .docs__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 38px;
    width: 38px;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    color: var(--text-2);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .docs__btn::-webkit-details-marker {
    display: none;
  }
  .docs__btn:hover,
  .docs[open] > .docs__btn {
    color: var(--text-strong);
    border-color: var(--text-3);
  }
  .docs__btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* On a phone the button is the book alone; its label stays its accessible name. */
  .docs__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
  .docs :global(.docs__chev) {
    display: none;
    width: 15px;
    height: 15px;
    transition: transform 0.16s ease;
  }
  .docs[open] :global(.docs__chev) {
    transform: rotate(180deg);
  }

  .docs__panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 60;
    max-height: calc(100dvh - 64px - 12px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 10px 8px 12px;
    background: var(--stage-2);
    border: 1px solid var(--stage-line);
    border-top: 0;
    border-radius: 0 0 14px 14px;
    box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.6);
  }
  .docs[open] > .docs__panel {
    animation: docs-in 0.16s ease-out;
  }
  @keyframes docs-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
  .docs__group {
    padding: 8px 10px 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-3);
  }
  .docs__sec + .docs__sec,
  .docs__list + .docs__group {
    margin-top: 6px;
    padding-top: 14px;
    border-top: 1px solid var(--stage-line);
  }
  .docs__list {
    display: grid;
    gap: 2px;
  }
  .docs__item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 10px;
    border-radius: 10px;
    color: var(--text-strong);
    text-decoration: none;
  }
  .docs__item:hover {
    color: var(--text-strong);
    background: rgba(255, 255, 255, 0.06);
  }
  .docs__item:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
    background: rgba(255, 255, 255, 0.06);
  }
  .docs__medal {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(127, 184, 212, 0.12);
    color: var(--accent);
  }
  .docs :global(.docs__icon) {
    width: 17px;
    height: 17px;
  }
  .docs__text {
    display: grid;
    gap: 1px;
    min-width: 0;
  }
  .docs__title {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
  }
  .docs__desc {
    font-size: 13px;
    line-height: 1.4;
    color: var(--text-3);
  }
  /* The article comes first and wears a little more of the accent. */
  .docs__item--article {
    background: rgba(127, 184, 212, 0.07);
  }
  .docs__item--article .docs__medal {
    background: var(--accent);
    color: var(--stage);
  }
  .docs__item--article:hover {
    background: rgba(127, 184, 212, 0.13);
  }
  .docs__item--article[aria-current="page"] .docs__title::after {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-left: 8px;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: middle;
  }
  /* The last row of the articles: a quiet link to the index, the same in every page. */
  .docs__all {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 2px;
    padding: 8px 10px 8px 54px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
  .docs__all:hover,
  .docs__all[aria-current="page"] {
    color: var(--text-strong);
    background: rgba(255, 255, 255, 0.06);
  }
  .docs__all:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .docs :global(.docs__arrow) {
    width: 16px;
    height: 16px;
    transition: transform 0.16s ease;
  }
  .docs__all:hover :global(.docs__arrow) {
    transform: translateX(3px);
  }
  /* Two levels (spec 005): with the script, the rail on the left names the groups and the pane shows one of them. */
  .docs__rail {
    display: none;
  }
  .docs--tabs .docs__rail {
    display: flex;
    gap: 4px;
  }
  .docs__tab {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 10px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--text-2);
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    text-align: left;
    cursor: pointer;
  }
  .docs__tab:hover {
    color: var(--text-strong);
  }
  .docs__tab:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .docs__tab[aria-pressed="true"] {
    color: var(--text-strong);
    background: rgba(127, 184, 212, 0.12);
  }
  .docs :global(.docs__tab-i) {
    width: 17px;
    height: 17px;
    flex: none;
    color: var(--accent);
  }
  .docs :global(.docs__tab-chev) {
    display: none;
    width: 15px;
    height: 15px;
    margin-left: auto;
    color: var(--text-3);
  }
  .docs--tabs .docs__sec {
    display: none;
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .docs--tabs [data-active="articles"] [data-docs-sec="articles"],
  .docs--tabs [data-active="tutorials"] [data-docs-sec="tutorials"],
  .docs--tabs [data-active="manual"] [data-docs-sec="manual"] {
    display: block;
  }
  /* In the pane, the group's name is the rail's job: it stays for screen readers only. */
  .docs--tabs .docs__group {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    padding: 0;
  }
  /* On a phone the rail is a row of three tabs above the pane. */
  @media (max-width: 639.98px) {
    .docs--tabs .docs__rail {
      padding: 0 2px 8px;
      margin-bottom: 6px;
      border-bottom: 1px solid var(--stage-line);
    }
    .docs--tabs .docs__tab {
      flex: 1;
      min-width: 0;
      justify-content: center;
      gap: 6px;
      padding: 9px 6px;
      font-size: 13px;
    }
  }
  /* Between phone and desktop, the wider panel hangs from the header's right gutter, not from the button. */
  @media (min-width: 640px) and (max-width: 1099.98px) {
    .docs--tabs {
      position: static;
    }
    .docs--tabs .docs__panel {
      top: calc(100% - 4px);
      right: var(--gutter);
    }
  }
  @media (min-width: 640px) {
    .docs--tabs .docs__panel {
      display: grid;
      grid-template-columns: 11.5rem minmax(0, 1fr);
      gap: 8px;
      width: min(38rem, calc(100vw - 32px));
    }
    .docs--tabs .docs__rail {
      flex-direction: column;
      padding-right: 8px;
      border-right: 1px solid var(--stage-line);
    }
    .docs :global(.docs__tab-chev) {
      display: block;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .docs[open] > .docs__panel {
      animation: none;
    }
    .docs :global(.docs__chev),
    .docs :global(.docs__arrow) {
      transition: none;
    }
    .docs__all:hover :global(.docs__arrow) {
      transform: none;
    }
  }
  @media (max-width: 639.98px) {
    /* On a phone the panel hangs from the whole header, the width of the screen. */
    .docs {
      position: static;
    }
  }
  @media (min-width: 640px) {
    .docs__btn {
      width: auto;
      padding: 8px 10px 8px 12px;
      border-color: transparent;
      font-size: 15px;
      font-weight: 500;
    }
    .docs__btn:hover,
    .docs[open] > .docs__btn {
      border-color: transparent;
      background: var(--surface-sunk);
    }
    .docs__label {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
    }
    .docs :global(.docs__chev) {
      display: block;
    }
    .docs__panel {
      top: calc(100% + 18px);
      left: auto;
      right: 0;
      width: 23rem;
      max-height: calc(100dvh - 64px - 24px);
      padding: 8px 8px 10px;
      border-top: 1px solid var(--stage-line);
      border-radius: 14px;
    }
  }
  @media (min-width: 640px) {
    .gh {
      display: inline-flex;
    }
  }
  /* The GitHub label is dropped on the narrower desktops, the French menu is the longest. */
  .gh__label {
    display: none;
  }
  /* The section menu needs room: from 1200px (the French one is the longest). Below, the rail or the dock lead. */
  @media (min-width: 1200px) {
    .nav {
      display: flex;
    }
  }
  @media (min-width: 1360px) {
    .gh__label {
      display: inline;
    }
  }
</style>
