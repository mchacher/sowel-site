---
import type { SiteCopy } from "../content/types";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { withBase } from "../lib/url";

interface Props {
  copy: SiteCopy;
  /** On an inner page: the home page of the language (section anchors lead back to it) and the other-language twin of this page. */
  inner?: { home: string; switchHref: string };
}
const { copy, inner } = Astro.props;
const to = (hash: string) => (inner ? withBase(inner.home) + hash : hash);
const switchHref = inner?.switchHref ?? copy.nav.switch.href;
---

<a class="skip" href="#main">{copy.a11y.skip}</a>
<header class="header">
  <div class="container header__inner">
    <a class="brand" href={to("#top")} aria-label={copy.a11y.home}>
      <Logo size={30} />
      <span class="brand__word">sowel</span>
    </a>
    <nav class="nav" aria-label={copy.a11y.nav}>
      {copy.nav.links.map((l) => <a href={to(l.href)}>{l.label}</a>)}
    </nav>
    <div class="header__actions">
      <a class="lang" href={switchHref} hreflang={copy.nav.switch.lang} lang={copy.nav.switch.lang} aria-label={copy.nav.switch.aria}>{copy.nav.switch.label}</a>
      <a class="gh" href={copy.nav.docs.href}>
        <Icon name="book-open" class="icon icon--sm" />
        <span>{copy.nav.docs.label}</span>
      </a>
      <a class="gh" href={copy.nav.github.href} aria-label={copy.nav.github.label}>
        <Icon name="git-fork" class="icon icon--sm" />
        <span class="gh__label">{copy.nav.github.label}</span>
      </a>
      <a class="btn btn--fill btn--sm" href={to(copy.hero.ctas.primary.href)}>{copy.hero.ctas.primary.label}</a>
    </div>
  </div>
</header>

<style>
  .skip {
    position: absolute;
    left: 12px;
    top: -48px;
    z-index: 100;
    padding: 8px 12px;
    border-radius: var(--r-sm);
    background: var(--p-fill);
    color: #fff;
  }
  .skip:focus {
    top: 12px;
  }
  /* The header belongs to the night stage, in both themes. */
  .header {
    --p-500: #f3f7fa;
    --text-2: #b9cfdc;
    --text-3: #8eabbd;
    --text-strong: #ffffff;
    --surface-sunk: rgba(255, 255, 255, 0.06);
    --border: rgba(169, 195, 211, 0.2);
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--stage);
    border-bottom: 1px solid rgba(169, 195, 211, 0.08);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--accent);
  }
  .brand__word {
    font-size: 21px;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: #fff;
    transform: translateY(-1px);
  }
  .nav {
    display: none;
    gap: 4px;
  }
  .nav a {
    padding: 8px 10px;
    white-space: nowrap;
    border-radius: var(--r-sm);
    font-size: 15px;
    font-weight: 500;
    color: var(--text-2);
  }
  .nav a:hover {
    color: var(--text-strong);
    background: var(--surface-sunk);
  }
  .header__actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .lang {
    display: inline-flex;
    align-items: center;
    height: 38px;
    padding-inline: 10px;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text-2);
  }
  .lang:hover {
    color: var(--text-strong);
    border-color: var(--text-3, var(--border));
  }
  .gh {
    display: none;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    font-size: 15px;
    font-weight: 500;
    color: var(--text-2);
  }
  .gh:hover {
    color: var(--text-strong);
  }
  .icon--sm {
    width: 18px;
    height: 18px;
  }
  .btn--sm {
    height: 38px;
    padding-inline: 16px;
    font-size: 14px;
    background: var(--stage-fill);
  }
  .btn--sm:hover {
    background: var(--stage-fill-hover);
  }
  @media (min-width: 640px) {
    .gh {
      display: inline-flex;
    }
  }
  /* The GitHub label is dropped on the narrower desktops, the French menu is the longest. */
  .gh__label {
    display: none;
  }
  /* The section menu needs room: from 1200px (the French one is the longest). Below, the rail or the dock lead. */
  @media (min-width: 1200px) {
    .nav {
      display: flex;
    }
  }
  @media (min-width: 1360px) {
    .gh__label {
      display: inline;
    }
  }
</style>
