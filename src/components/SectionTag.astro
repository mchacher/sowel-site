---
import type { IconName } from "../content/types";
import Icon from "./Icon.astro";

interface Props {
  text: string;
  icon: IconName | "newspaper" | "graduation-cap";
  /** The compact tag, for an article's header. */
  small?: boolean;
}
const { text, icon, small = false } = Astro.props;
---

<p class:list={["section-tag", { "section-tag--sm": small }]}>
  <span class="section-tag__chip"><Icon name={icon} class="section-tag__icon" /></span>
  {text}
</p>

<style>
  /* The name of a section: a soft blue card with a raised white medallion carrying the section's icon. */
  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    padding: 6px 22px 6px 6px;
    border-radius: 18px;
    margin-bottom: 30px; /* with the title's own 14px: the name stands apart from the title */
    background: color-mix(in srgb, var(--accent-mark) 17%, var(--surface));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent-mark) 38%, transparent);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.1;
    color: var(--accent-ink);
  }
  .section-tag__chip {
    display: grid;
    place-items: center;
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: linear-gradient(145deg, var(--accent-mark), var(--accent-ink));
    color: #fff;
    box-shadow: 0 6px 12px -6px color-mix(in srgb, var(--accent-ink) 60%, transparent);
  }
  /* On the dark privacy block a solid blue card would melt into the background: it turns light instead. */
  :global(.privacy) .section-tag {
    background: #e6f1f7;
    color: #123f59;
    box-shadow: 0 12px 24px -12px rgba(0, 0, 0, 0.6);
  }
  :global(.privacy) .section-tag__chip {
    background: #1a4f6e;
    color: #fff;
  }
  .section-tag :global(.section-tag__icon) {
    width: 22px;
    height: 22px;
  }
  /* The compact tag of an article: the same card and medallion, at the size of a label. */
  .section-tag--sm,
  .section-tag.section-tag--sm {
    gap: 10px;
    margin-bottom: 0;
    padding: 4px 14px 4px 4px;
    border-radius: 12px;
    font-size: 14px;
  }
  .section-tag--sm .section-tag__chip,
  .section-tag.section-tag--sm .section-tag__chip {
    width: 28px;
    height: 28px;
    border-radius: 8px;
  }
  .section-tag--sm :global(.section-tag__icon),
  .section-tag.section-tag--sm :global(.section-tag__icon) {
    width: 16px;
    height: 16px;
  }
  @media (max-width: 639px) {
    .section-tag:not(.section-tag--sm) {
      gap: 12px;
      padding-right: 20px;
      font-size: 17px;
    }
    .section-tag:not(.section-tag--sm) .section-tag__chip {
      width: 40px;
      height: 40px;
      border-radius: 11px;
    }
    .section-tag:not(.section-tag--sm) :global(.section-tag__icon) {
      width: 21px;
      height: 21px;
    }
  }
</style>
