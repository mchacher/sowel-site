---
import type { IconName } from "../content/types";
import Icon from "./Icon.astro";

interface Props {
  text: string;
  icon: IconName;
}
const { text, icon } = Astro.props;
---

<p class="section-tag">
  <span class="section-tag__chip"><Icon name={icon} class="section-tag__icon" /></span>
  {text}
</p>

<style>
  /* The name of a section: a soft blue card with a raised white medallion carrying the section's icon. */
  .section-tag {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    padding: 7px 24px 7px 7px;
    border-radius: 18px;
    background: linear-gradient(135deg, var(--tile), color-mix(in srgb, var(--tile) 72%, #0b1419));
    box-shadow: 0 12px 24px -12px color-mix(in srgb, var(--tile) 70%, transparent);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.1;
    color: #fff;
  }
  .section-tag__chip {
    display: grid;
    place-items: center;
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 13px;
    background: #fff;
    color: #1a4f6e;
  }
  /* On the dark privacy block a solid blue card would melt into the background: it turns light instead. */
  :global(.privacy) .section-tag {
    background: #e6f1f7;
    color: #123f59;
    box-shadow: 0 12px 24px -12px rgba(0, 0, 0, 0.6);
  }
  :global(.privacy) .section-tag__chip {
    background: #1a4f6e;
    color: #fff;
  }
  .section-tag :global(.section-tag__icon) {
    width: 24px;
    height: 24px;
  }
  @media (max-width: 639px) {
    .section-tag {
      gap: 12px;
      padding-right: 20px;
      font-size: 17px;
    }
    .section-tag__chip {
      width: 40px;
      height: 40px;
      border-radius: 11px;
    }
    .section-tag :global(.section-tag__icon) {
      width: 21px;
      height: 21px;
    }
  }
</style>
