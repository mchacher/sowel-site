---
import type { IconName, SiteCopy } from "../content/types";
import Icon from "./Icon.astro";

interface Props {
  copy: SiteCopy;
}
const { copy } = Astro.props;

// One icon per section, the same as on the section names.
const ICONS: Record<string, IconName> = {
  "#home": "house",
  "#rooms": "layout-grid",
  "#dashboard": "sliders-horizontal",
  "#recipes": "chef-hat",
  "#modes": "sun-moon",
  "#energy": "zap",
  "#privacy": "shield-check",
};
const items = copy.nav.links.filter((l) => ICONS[l.href]).map((l) => ({ ...l, icon: ICONS[l.href] }));
---

<nav class="snav" aria-label={copy.a11y.sections} data-snav>
  <!-- Wide screens: a rail of dots at the right edge. -->
  <ol class="snav__rail">
    {
      items.map((l) => (
        <li>
          <a href={l.href} data-snav-link aria-label={l.label}>
            <span class="snav__name">{l.label}</span>
            <span class="snav__dot"></span>
          </a>
        </li>
      ))
    }
  </ol>
  <!-- Phones and tablets: a dock at the bottom, the active icon names its section. -->
  <ol class="snav__dock">
    {
      items.map((l) => (
        <li>
          <a href={l.href} data-snav-link aria-label={l.label}>
            <Icon name={l.icon} class="snav__icon" />
            <span class="snav__label">{l.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>("[data-snav]");
  if (nav) {
    const links = [...nav.querySelectorAll<HTMLAnchorElement>("[data-snav-link]")];
    const ids = [...new Set(links.map((a) => a.getAttribute("href")!.slice(1)))];
    const sections = ids.map((id) => document.getElementById(id)).filter((s): s is HTMLElement => !!s);

    const setActive = (id: string) => {
      for (const a of links) {
        const on = a.getAttribute("href") === `#${id}`;
        if (on) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      }
    };

    // The section crossing the middle band of the screen is the one being read.
    const seen = new Map<string, boolean>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) seen.set(e.target.id, e.isIntersecting);
        const current = sections.filter((s) => seen.get(s.id)).pop();
        if (current) setActive(current.id);
      },
      { rootMargin: "-45% 0px -50% 0px" },
    );
    sections.forEach((s) => io.observe(s));

    // Hidden over the hero and over the footer, where it would only be in the way.
    const first = sections[0];
    const footer = document.querySelector("footer");
    let queued = false;
    const update = () => {
      queued = false;
      const pastHero = first ? first.getBoundingClientRect().top < innerHeight * 0.45 : true;
      const atFooter = footer ? footer.getBoundingClientRect().top < innerHeight * 0.9 : false;
      nav.classList.toggle("is-on", pastHero && !atFooter);
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    addEventListener("scroll", queue, { passive: true });
    addEventListener("resize", queue);
    update();
  }
</script>

<style>
  .snav {
    position: fixed;
    z-index: 40;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }
  .snav.is-on {
    opacity: 1;
    pointer-events: auto;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    text-decoration: none;
  }

  /* Rail, wide screens */
  .snav__rail {
    display: none;
  }
  .snav__dock {
    display: flex;
    gap: 4px;
    padding: 6px;
    border-radius: 20px;
    background: rgba(11, 20, 25, 0.92);
    box-shadow: 0 14px 30px -10px rgba(0, 0, 0, 0.5);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .snav {
    left: 50%;
    bottom: calc(14px + env(safe-area-inset-bottom, 0px));
    transform: translate(-50%, 12px);
  }
  .snav.is-on {
    transform: translate(-50%, 0);
  }
  .snav__dock a {
    display: flex;
    align-items: center;
    height: 40px;
    min-width: 40px;
    justify-content: center;
    border-radius: 14px;
    color: #9fb3c0;
  }
  .snav__dock a[aria-current="true"] {
    background: var(--accent);
    color: #0b1419;
    padding: 0 14px 0 11px;
    gap: 7px;
    font-size: 13px;
    font-weight: 700;
  }
  .snav__dock .snav__label {
    display: none;
    white-space: nowrap;
  }
  .snav__dock a[aria-current="true"] .snav__label {
    display: inline;
  }
  .snav :global(.snav__icon) {
    width: 18px;
    height: 18px;
    flex: none;
  }
  .snav__dock a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (max-width: 1099px) {
    :global(body) {
      padding-bottom: 76px;
    }
  }

  @media (min-width: 1100px) {
    .snav {
      left: auto;
      bottom: auto;
      right: 12px;
      top: 50%;
      transform: translate(8px, -50%);
    }
    .snav.is-on {
      transform: translate(0, -50%);
    }
    .snav__dock {
      display: none;
    }
    .snav__rail {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 6px;
      position: relative;
    }
    .snav__rail a {
      position: relative;
      display: flex;
      align-items: center;
      gap: 10px;
      height: 28px;
      padding-right: 8px;
    }
    /* The line is drawn in segments from each dot's own box: whole pixels, so it sits exactly on the dots' axis. */
    .snav__rail li:not(:last-child) a::before {
      content: "";
      position: absolute;
      right: 12px; /* 8px padding + half the dot (5px) - half the line (1px) */
      top: 50%;
      width: 2px;
      height: 34px; /* the link (28px) + the gap (6px) */
      background: color-mix(in srgb, var(--text-2) 25%, transparent);
    }
    .snav__name {
      padding: 4px 10px;
      border-radius: 9px;
      background: var(--surface);
      box-shadow: 0 0 0 1px var(--border), 0 8px 18px -10px rgba(17, 23, 27, 0.45);
      font-size: 13px;
      font-weight: 650;
      color: var(--accent-ink);
      white-space: nowrap;
      opacity: 0;
      transform: translateX(6px);
      transition:
        opacity 0.18s ease,
        transform 0.18s ease;
    }
    .snav__rail a:hover .snav__name,
    .snav__rail a:focus-visible .snav__name,
    .snav__rail a[aria-current="true"] .snav__name {
      opacity: 1;
      transform: none;
    }
    .snav__dot {
      position: relative;
      z-index: 1;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: color-mix(in srgb, var(--text-2) 45%, var(--surface));
      transition:
        background 0.18s ease,
        box-shadow 0.18s ease,
        transform 0.18s ease;
    }
    .snav__rail a:hover .snav__dot {
      background: var(--accent-mark);
    }
    .snav__rail a[aria-current="true"] .snav__dot {
      background: var(--accent-mark);
      transform: scale(1.25);
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent-mark) 22%, transparent);
    }
    .snav__rail a:focus-visible {
      outline: none;
    }
    .snav__rail a:focus-visible .snav__dot {
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent-mark) 40%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .snav,
    .snav__name,
    .snav__dot {
      transition: none;
    }
  }
</style>
