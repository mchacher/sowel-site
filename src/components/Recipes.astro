---
import type { SiteCopy } from "../content/types";
import Icon from "./Icon.astro";

interface Props {
  copy: SiteCopy;
}
const { recipes } = Astro.props.copy;
---

<section class="section" id={recipes.id}>
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <p class="eyebrow">{recipes.eyebrow}</p>
      <h2 class="h2">{recipes.title}</h2>
      <p class="lead">{recipes.lead}</p>
    </div>

    <ul class="grid">
      {
        recipes.cards.map((c, i) => (
          <li class="rc" data-reveal style={`--delay:${i * 70}ms`}>
            <div class="rc__top">
              <span class="rc__tile">
                <Icon name={c.icon} class="icon" />
              </span>
              {c.running && (
                <span class="run">
                  <span class="run__dot" />
                  {recipes.running}
                </span>
              )}
            </div>
            <h3 class="rc__title">{c.title}</h3>
            <p class="rc__body">{c.body}</p>
            <dl class="rc__meta">
              <div>
                <dt>{recipes.placedOn}</dt>
                <dd>
                  <span class="room">{c.room}</span>
                </dd>
              </div>
              <div>
                <dt>{recipes.asks}</dt>
                <dd class="rc__asks">
                  {c.settings.map((s) => (
                    <span class="ask">{s}</span>
                  ))}
                </dd>
              </div>
            </dl>
          </li>
        ))
      }
    </ul>

    <div class="ai" data-reveal>
      <div class="ai__text">
        <span class="ai__tag"><Icon name="sparkles" class="icon" />{recipes.ai.tag}</span>
        <h3>{recipes.ai.title}</h3>
        <p>{recipes.ai.body}</p>
      </div>
      <ol class="ai__steps">
        {
          recipes.ai.steps.map((s, i) => (
            <li>
              <span class="ai__n">{i + 1}</span>
              {s}
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .grid {
    margin-top: clamp(48px, 6vw, 72px);
    display: grid;
    gap: 16px;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }
  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .rc {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: 0;
    padding: 24px;
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .rc:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }
  .rc__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
  }
  .rc__tile {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-md);
    background: var(--p-50);
    color: var(--p-500);
  }
  .run {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--active-bg);
    color: var(--active-ink);
    font-size: 12.5px;
    font-weight: 600;
  }
  .run__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--active);
  }
  @media (prefers-reduced-motion: no-preference) {
    .run__dot {
      animation: pulse 2.4s ease-in-out infinite;
    }
  }
  @keyframes pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--active) 55%, transparent);
    }
    50% {
      box-shadow: 0 0 0 5px color-mix(in srgb, var(--active) 0%, transparent);
    }
  }
  .rc__title {
    margin-top: 20px;
    font-size: 18px;
    line-height: 1.3;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--text-strong);
  }
  .rc__body {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-2);
  }
  .rc__meta {
    margin: 0;
    align-self: start;
    padding-top: 20px;
    display: grid;
    gap: 12px;
  }
  .rc__meta > div:first-child {
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  dt {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-3);
    margin-bottom: 6px;
  }
  dd {
    margin: 0;
  }
  .room {
    display: inline-flex;
    align-items: center;
    height: 26px;
    padding: 0 10px;
    border-radius: var(--r-sm);
    background: var(--p-50);
    color: var(--p-500);
    font-size: 13px;
    font-weight: 600;
  }
  .rc__asks {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .ask {
    display: inline-flex;
    align-items: center;
    height: 26px;
    padding: 0 9px;
    border-radius: var(--r-sm);
    border: 1px solid var(--border);
    font-size: 12.5px;
    color: var(--text-2);
  }

  .ai {
    margin-top: 20px;
    display: grid;
    gap: 28px;
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--r-lg);
    background:
      radial-gradient(70% 140% at 100% 0%, color-mix(in srgb, var(--p-mid) 18%, transparent), transparent 60%),
      var(--p-50);
    border: 1px solid color-mix(in srgb, var(--p-mid) 30%, var(--border));
  }
  @media (min-width: 900px) {
    .ai {
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
      gap: 48px;
    }
  }
  .ai__tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px 5px 10px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    font-size: 13px;
    font-weight: 600;
    color: var(--p-500);
  }
  .ai__tag .icon {
    width: 16px;
    height: 16px;
  }
  .ai h3 {
    margin-top: 18px;
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.875rem);
    line-height: 1.2;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--text-strong);
  }
  .ai p {
    margin-top: 10px;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--text-2);
    max-width: 36em;
  }
  .ai__steps {
    display: grid;
    gap: 10px;
  }
  .ai__steps li {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border-radius: var(--r-md);
    background: var(--surface);
    border: 1px solid var(--border);
    font-size: 16px;
    font-weight: 550;
    color: var(--text-strong);
  }
  .ai__n {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--p-fill);
    color: #fff;
    font-size: 13px;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }
</style>
