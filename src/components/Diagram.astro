---
// A diagram of an article (spec 002): the arbiter at work. The arbiter reads the main meter and the priority order, the recipe of each
// appliance asks it for surplus (arrow up) and it answers (arrow down): granted, waiting or at rest. The answer is
// told by an icon and a word, never by colour alone. The diagram is inline SVG drawn from CSS variables (both themes,
// no request, no script). Two layouts, the card's width picks one: a row of appliances under the arbiter, or a
// column of them hanging from a trunk on a phone. Every label comes from the article's content module.
import Icon from "./Icon.astro";
import type { Block, LoadState } from "../content/articles/types";

interface Props {
  block: Extract<Block, { kind: "diagram" }>;
  /** Unique within the page, for the ids of the diagram's title and description. */
  uid: string;
}
const { block, uid } = Astro.props;
const il = block.illustration;

const stateIcon: Record<LoadState, "circle-check" | "hourglass" | "moon"> = {
  granted: "circle-check",
  waiting: "hourglass",
  rest: "moon",
};
const CHIP = { w: 176, h: 26 };

// Wide layout: meter, arbiter and priorities on a row; under the arbiter a column per appliance, the request, the
// answer, then the appliance with its recipe.
const W = { w: 722, card: 220, gap: 30, askY: 112, ansY: 156, detailY: 206, chipY: 222, cardY: 234, cardH: 120 };
const wideH = W.cardY + W.cardH + 2;
const wide = il.loads.map((l, n) => {
  const x = 1 + n * (W.card + W.gap);
  return { ...l, x, cx: x + W.card / 2 };
});
const hubX = 361;
const wire = (cx: number) =>
  cx === hubX
    ? `M${hubX} 82 V${W.chipY}`
    : `M${hubX} 82 V94 Q${hubX} 102 ${hubX + (cx > hubX ? 8 : -8)} 102 H${cx + (cx > hubX ? -8 : 8)} Q${cx} 102 ${cx} 110 V${W.chipY}`;

// Narrow layout: two inputs, the arbiter, then a trunk down the left with a block per appliance.
const N = { w: 340, trunk: 38, chipX: 54, hubY: 84, first: 192, step: 190, cardDy: 80, cardH: 88 };
const narrow = il.loads.map((l, n) => ({ ...l, top: N.first + n * N.step }));
const lastTop = narrow.at(-1)?.top ?? N.first;
const nH = lastTop + N.cardDy + N.cardH + 4;
const ids = (k: string) => ({ title: `${uid}-${k}-t`, desc: `${uid}-${k}-d` });
const wi = ids("w");
const ni = ids("n");
---


<div class="hl hl--diagram">
  <div class="hl__fig">
    <svg
      class="hl__svg hl__svg--wide"
      viewBox={`0 0 ${W.w} ${wideH}`}
      role="img"
      aria-labelledby={wi.title}
      aria-describedby={wi.desc}
    >
      <title id={wi.title}>{il.title}</title>
      <desc id={wi.desc}>{il.desc}</desc>
      <g class="hl__wires">
        {wide.map((l) => <path class="hl__wire" d={wire(l.cx)} pathLength="1" />)}
        <path class="hl__wire" d="M166 44 H197 M190 37 L197 44 L190 51" pathLength="1" />
        <path class="hl__wire" d="M556 44 H525 M532 37 L525 44 L532 51" pathLength="1" />
      </g>
      <g class="hl__input">
        <rect x="0" y="6" width="161" height="76" rx="14" />
        <Icon name="gauge" class="hl__ico" x="70" y="14" width="22" height="22" />
        <text class="hl__in-name" x="80.5" y="55" text-anchor="middle">{il.meter.name}</text>
        <text class="hl__in-tag" x="80.5" y="72" text-anchor="middle">{il.meter.tag}</text>
      </g>
      <g class="hl__input">
        <rect x="561" y="6" width="161" height="76" rx="14" />
        <Icon name="list-ordered" class="hl__ico" x="630" y="14" width="22" height="22" />
        <text class="hl__in-name" x="641.5" y="55" text-anchor="middle">{il.order.name}</text>
        <text class="hl__in-tag" x="641.5" y="72" text-anchor="middle">{il.order.tag}</text>
      </g>
      <g class="hl__hub">
        <rect x={hubX - 160} y="6" width="320" height="76" rx="16" />
        <circle class="hl__hub-ring" cx={hubX - 120} cy="44" r="23" />
        <Icon name={il.hub.icon} class="hl__ico hl__ico--hub" x={hubX - 133} y="31" width="26" height="26" />
        <text class="hl__hub-name" x={hubX - 84} y="39">{il.hub.name}</text>
        <text class="hl__hub-tag" x={hubX - 84} y="63">{il.hub.tag}</text>
      </g>
      {
        wide.map((l) => (
          <g class="hl__load">
            <g class="hl__say">
              <rect class="hl__bubble" x={l.cx - CHIP.w / 2} y={W.askY} width={CHIP.w} height={CHIP.h} rx="13" />
              <Icon name="arrow-up" class="hl__ico hl__ico--ask" x={l.cx - CHIP.w / 2 + 10} y={W.askY + 5} width="16" height="16" />
              <text class="hl__say-text" x={l.cx - CHIP.w / 2 + 34} y={W.askY + 17.5}>{l.ask}</text>
            </g>
            <g class={`hl__say hl__say--${l.state}`}>
              <rect class="hl__bubble" x={l.cx - CHIP.w / 2} y={W.ansY} width={CHIP.w} height={CHIP.h} rx="13" />
              <Icon name="arrow-down" class="hl__ico hl__ico--ans" x={l.cx - CHIP.w / 2 + 10} y={W.ansY + 5} width="16" height="16" />
              <text class="hl__say-text" x={l.cx - CHIP.w / 2 + 34} y={W.ansY + 17.5}>{l.answer}</text>
              <Icon name={stateIcon[l.state]} class="hl__ico hl__ico--state" x={l.cx + CHIP.w / 2 - 28} y={W.ansY + 5} width="16" height="16" />
            </g>
            {l.detail && <text class="hl__detail" x={l.cx} y={W.detailY} text-anchor="middle">{l.detail}</text>}
            <rect class="hl__card" x={l.x} y={W.cardY} width={W.card} height={W.cardH} rx="12" />
            <circle class="hl__ring" cx={l.cx} cy={W.cardY + 46} r="20" />
            <Icon name={l.icon} class="hl__ico" x={l.cx - 11} y={W.cardY + 35} width="22" height="22" />
            <text class="hl__name" x={l.cx} y={W.cardY + 88} text-anchor="middle">{l.name}</text>
            <text class="hl__tag" x={l.cx} y={W.cardY + 108} text-anchor="middle">{il.loadTag}</text>
            <rect class="hl__chip" x={l.cx - 50} y={W.chipY} width="100" height="25" rx="12.5" />
            <Icon name="chef-hat" class="hl__ico hl__ico--chip" x={l.cx - 38} y={W.chipY + 5} width="15" height="15" />
            <text class="hl__chip-label" x={l.cx - 18} y={W.chipY + 17.5}>{il.recipe}</text>
          </g>
        ))
      }
    </svg>

    <svg
      class="hl__svg hl__svg--narrow"
      viewBox={`0 0 ${N.w} ${nH}`}
      role="img"
      aria-labelledby={ni.title}
      aria-describedby={ni.desc}
    >
      <title id={ni.title}>{il.title}</title>
      <desc id={ni.desc}>{il.desc}</desc>
      <g class="hl__wires">
        <path class="hl__wire" d={`M${N.trunk} ${N.hubY + 76} V${lastTop + N.cardDy - 12} Q${N.trunk} ${lastTop + N.cardDy} ${N.trunk + 12} ${lastTop + N.cardDy} H${N.chipX}`} pathLength="1" />
        {narrow.map((l) => <path class="hl__wire" d={`M${N.trunk} ${l.top + 13} H${N.chipX} M${N.trunk} ${l.top + 49} H${N.chipX}`} pathLength="1" />)}
        {narrow.slice(0, -1).map((l) => <path class="hl__wire" d={`M${N.trunk} ${l.top + N.cardDy} H${N.chipX}`} pathLength="1" />)}
        <path class="hl__wire" d="M84 54 V80 M78 74 L84 80 L90 74" pathLength="1" />
        <path class="hl__wire" d="M256 54 V80 M250 74 L256 80 L262 74" pathLength="1" />
      </g>
      <g class="hl__input">
        <rect x="0" y="0" width="168" height="54" rx="12" />
        <Icon name="gauge" class="hl__ico" x="10" y="9" width="20" height="20" />
        <text class="hl__in-name" x="38" y="25">{il.meter.name}</text>
        <text class="hl__in-tag" x="38" y="43">{il.meter.tag}</text>
      </g>
      <g class="hl__input">
        <rect x="172" y="0" width="168" height="54" rx="12" />
        <Icon name="list-ordered" class="hl__ico" x="182" y="9" width="20" height="20" />
        <text class="hl__in-name" x="210" y="25">{il.order.name}</text>
        <text class="hl__in-tag" x="210" y="43">{il.order.tag}</text>
      </g>
      <g class="hl__hub">
        <rect x="0" y={N.hubY} width={N.w} height="76" rx="16" />
        <circle class="hl__hub-ring" cx={N.trunk} cy={N.hubY + 38} r="22" />
        <Icon name={il.hub.icon} class="hl__ico hl__ico--hub" x={N.trunk - 12} y={N.hubY + 26} width="24" height="24" />
        <text class="hl__hub-name" x="76" y={N.hubY + 33}>{il.hub.name}</text>
        <text class="hl__hub-tag" x="76" y={N.hubY + 57}>{il.hub.tag}</text>
      </g>
      {
        narrow.map((l) => (
          <g class="hl__load">
            <g class="hl__say">
              <rect class="hl__bubble" x={N.chipX} y={l.top} width={CHIP.w} height={CHIP.h} rx="13" />
              <Icon name="arrow-up" class="hl__ico hl__ico--ask" x={N.chipX + 10} y={l.top + 5} width="16" height="16" />
              <text class="hl__say-text" x={N.chipX + 34} y={l.top + 17.5}>{l.ask}</text>
            </g>
            <g class={`hl__say hl__say--${l.state}`}>
              <rect class="hl__bubble" x={N.chipX} y={l.top + 36} width={CHIP.w} height={CHIP.h} rx="13" />
              <Icon name="arrow-down" class="hl__ico hl__ico--ans" x={N.chipX + 10} y={l.top + 41} width="16" height="16" />
              <text class="hl__say-text" x={N.chipX + 34} y={l.top + 53.5}>{l.answer}</text>
              <Icon name={stateIcon[l.state]} class="hl__ico hl__ico--state" x={N.chipX + CHIP.w - 28} y={l.top + 41} width="16" height="16" />
            </g>
            {l.detail && <text class="hl__detail" x={N.chipX + CHIP.w + 10} y={l.top + 54}>{l.detail}</text>}
            <rect class="hl__card" x={N.chipX} y={l.top + N.cardDy} width={N.w - N.chipX - 1} height={N.cardH} rx="12" />
            <circle class="hl__ring" cx={N.chipX + 32} cy={l.top + N.cardDy + 50} r="19" />
            <Icon name={l.icon} class="hl__ico" x={N.chipX + 21} y={l.top + N.cardDy + 39} width="22" height="22" />
            <text class="hl__name" x={N.chipX + 64} y={l.top + N.cardDy + 47}>{l.name}</text>
            <text class="hl__tag" x={N.chipX + 64} y={l.top + N.cardDy + 69}>{il.loadTag}</text>
            <rect class="hl__chip" x={N.chipX + 14} y={l.top + N.cardDy - 12.5} width="100" height="25" rx="12.5" />
            <Icon name="chef-hat" class="hl__ico hl__ico--chip" x={N.chipX + 26} y={l.top + N.cardDy - 7.5} width="15" height="15" />
            <text class="hl__chip-label" x={N.chipX + 46} y={l.top + N.cardDy + 5}>{il.recipe}</text>
          </g>
        ))
      }
    </svg>
  </div>
</div>

<style>
  /* The card: the soft well of the figures (its width is set by the article). */
  .hl {
    container-type: inline-size;
    padding: clamp(16px, 3vw, 30px);
    border-radius: var(--r-lg);
    border: 1px solid var(--border);
    background:
      radial-gradient(75% 60% at 50% 100%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 72%),
      var(--n-50);
  }

  .hl__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font);
  }
  .hl__svg--wide {
    display: none;
  }
  .hl__svg--narrow {
    max-width: 26rem;
    margin-inline: auto;
  }
  @container (min-width: 600px) {
    .hl__svg--wide {
      display: block;
    }
    .hl__svg--narrow {
      display: none;
    }
  }

  .hl__wire {
    fill: none;
    stroke: var(--accent-mark);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.75;
  }
  .hl__input rect {
    fill: var(--surface);
    stroke: var(--border-strong);
    stroke-width: 1;
  }
  .hl__in-name {
    font-size: 14px;
    font-weight: 650;
    fill: var(--text-strong);
  }
  .hl__in-tag {
    font-size: 12.5px;
    font-weight: 500;
    fill: var(--text-2);
  }
  .hl__hub rect {
    fill: var(--tile);
  }
  .hl__hub-ring {
    fill: var(--tile-line);
  }
  .hl__hub-name {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.01em;
    fill: var(--tile-text);
  }
  .hl__hub-tag {
    font-size: 14px;
    font-weight: 500;
    fill: var(--tile-text-2);
  }

  /* The dialogue: a request going up, an answer coming down. */
  .hl__bubble {
    fill: var(--surface);
    stroke: var(--border-strong);
    stroke-width: 1;
  }
  .hl__say-text {
    font-size: 13.5px;
    font-weight: 600;
    fill: var(--text-strong);
  }
  .hl__detail {
    font-size: 12.5px;
    font-weight: 500;
    fill: var(--text-2);
  }
  .hl__say--granted .hl__bubble {
    fill: var(--tile);
    stroke: var(--tile);
  }
  .hl__say--granted .hl__say-text {
    fill: var(--tile-text);
  }
  .hl__say--waiting .hl__bubble {
    fill: var(--p-50);
    stroke: var(--accent-mark);
  }
  .hl__say--waiting .hl__say-text {
    fill: var(--accent-ink);
  }
  .hl__say--rest .hl__bubble {
    stroke-dasharray: 4 3;
  }
  .hl__say--rest .hl__say-text {
    fill: var(--text-2);
  }

  .hl__card {
    fill: var(--surface);
    stroke: var(--border-strong);
    stroke-width: 1;
  }
  .hl__ring {
    fill: var(--p-50);
  }
  .hl__name {
    font-size: 16px;
    font-weight: 650;
    fill: var(--text-strong);
  }
  .hl__tag {
    font-size: 13.5px;
    font-weight: 500;
    fill: var(--text-2);
  }
  .hl__chip {
    fill: var(--p-50);
    stroke: color-mix(in srgb, var(--accent-mark) 55%, transparent);
    stroke-width: 1;
  }
  .hl__chip-label {
    font-size: 13.5px;
    font-weight: 600;
    fill: var(--accent-ink);
  }
  .hl :global(.hl__ico) {
    fill: none;
    stroke: var(--accent-ink);
  }
  .hl :global(.hl__ico--hub) {
    stroke: var(--tile-text);
  }
  .hl :global(.hl__ico--ask),
  .hl :global(.hl__ico--ans) {
    stroke: var(--text-strong);
  }
  .hl__say--granted :global(.hl__ico) {
    stroke: var(--tile-text);
  }
  .hl__say--rest :global(.hl__ico) {
    stroke: var(--text-2);
  }

  /* A one-shot draw of the wires, none under reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .hl__wire {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: hl-draw 0.9s 0.25s ease-out forwards;
    }
  }
  @keyframes hl-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
