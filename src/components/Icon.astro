---
// Lucide icons, inlined at build time (stroke 1.5, as in the product). No request at runtime.
import type { IconName } from "../content/types";
import type { DiagramIcon } from "../content/articles/types";

interface Props {
  name: IconName | "copy" | "check" | "arrow-right" | "play" | "terminal" | "newspaper" | "calendar" | "clock" | "chevron-down" | "quote" | "graduation-cap" | "lightbulb" | "triangle-alert" | "info" | "file-code" | "chevron-right" | "book-open" | DiagramIcon;
  class?: string;
  /** Placement when the icon is nested in a larger SVG (a diagram). */
  x?: number | string;
  y?: number | string;
  width?: number | string;
  height?: number | string;
}

const sources = import.meta.glob<string>("/node_modules/lucide-static/icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

const { name, class: className = "icon", ...rest } = Astro.props;
const raw = sources[`/node_modules/lucide-static/icons/${name}.svg`];
if (!raw) throw new Error(`Unknown icon: ${name}`);
const inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, "").replace(/<\/svg>\s*$/, "");
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  {...rest}
  set:html={inner}
/>
