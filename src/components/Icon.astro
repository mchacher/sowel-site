---
// Lucide icons, inlined at build time (stroke 1.5, as in the product). No request at runtime.
import type { IconName } from "../content/types";

interface Props {
  name: IconName | "copy" | "check" | "arrow-right" | "play" | "terminal" | "newspaper" | "calendar" | "clock" | "chevron-down" | "quote";
  class?: string;
}

const sources = import.meta.glob<string>("/node_modules/lucide-static/icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

const { name, class: className = "icon", ...rest } = Astro.props;
const raw = sources[`/node_modules/lucide-static/icons/${name}.svg`];
if (!raw) throw new Error(`Unknown icon: ${name}`);
const inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, "").replace(/<\/svg>\s*$/, "");
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  {...rest}
  set:html={inner}
/>
