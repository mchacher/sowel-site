---
import type { SiteCopy } from "../content/types";
import InstallCommand from "./InstallCommand.astro";
import Icon from "./Icon.astro";

interface Props {
  copy: SiteCopy;
}
const { hero } = Astro.props.copy;
---

<section class="hero" id="top">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="container hero__inner">
    <p class="eyebrow hero__eyebrow">{hero.eyebrow}</p>
    <h1 class="hero__title">{hero.title}</h1>
    <p class="hero__lead">{hero.lead}</p>

    <div class="hero__install">
      <p class="hero__label">{hero.install.label}</p>
      <InstallCommand
        command={hero.install.command}
        copy={hero.install.copy}
        copied={hero.install.copied}
        label={hero.install.label}
      />
      <p class="hero__note">
        {hero.install.note}
        <a href={hero.ctas.secondary.href}>{hero.ctas.secondary.label}<Icon name="arrow-right" class="icon arrow" /></a>
      </p>
    </div>

    <figure class="film" data-reveal>
      <div class="film__frame">
        <video controls preload="none" playsinline poster={hero.film.poster} width="1280" height="720" aria-label={hero.film.label}>
          <source src={hero.film.src} type="video/mp4" />
          <p>{hero.film.fallback} <a href={hero.film.src}>{hero.film.fallbackLink}</a></p>
        </video>
        <button class="film__play" type="button" data-play hidden>
          <span class="film__playdisc"><Icon name="play" class="icon" /></span>
          <span class="film__playtext">{hero.film.label}<span>{hero.film.duration}</span></span>
        </button>
      </div>
      <figcaption class="film__fallback">
        {hero.film.fallback} <a href={hero.film.src}>{hero.film.fallbackLink}</a>
      </figcaption>
    </figure>
  </div>
</section>

<script is:inline>
  (() => {
    const btn = document.querySelector("[data-play]");
    const video = btn && btn.parentElement.querySelector("video");
    if (!btn || !video) return;
    btn.hidden = false;
    video.controls = false;
    const start = () => {
      btn.hidden = true;
      video.controls = true;
      video.play().catch(() => {});
    };
    btn.addEventListener("click", start);
    video.addEventListener("play", () => { btn.hidden = true; video.controls = true; });
    video.addEventListener("error", () => document.querySelector(".film")?.classList.add("is-failed"), true);
    video.querySelector("source")?.addEventListener("error", () => document.querySelector(".film")?.classList.add("is-failed"));
  })();
</script>

<style>
  .hero {
    position: relative;
    padding-top: clamp(56px, 9vw, 120px);
    padding-bottom: clamp(64px, 8vw, 112px);
    overflow: hidden;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(70% 55% at 50% -5%, var(--warm-peach) 0%, transparent 70%),
      radial-gradient(55% 45% at 85% 60%, var(--warm-sun) 0%, transparent 70%),
      radial-gradient(50% 40% at 12% 70%, var(--warm-sky) 0%, transparent 70%);
  }
  .hero__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--border) 1px, transparent 1px),
      linear-gradient(to bottom, var(--border) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(70% 45% at 50% 0%, #000 0%, transparent 75%);
    opacity: 0.55;
  }
  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero__eyebrow {
    padding: 6px 14px 6px 12px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
    font-size: 13.5px;
    color: var(--text-2);
  }
  .hero__eyebrow::before {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--success);
    opacity: 1;
  }
  .hero__title {
    margin-top: 28px;
    font-size: clamp(2.75rem, 1.2rem + 6.4vw, 5.75rem);
    line-height: 1;
    font-weight: 720;
    letter-spacing: -0.045em;
    color: var(--text-strong);
    background: linear-gradient(95deg, var(--title-from) 15%, var(--title-mid) 70%, var(--title-to) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    text-wrap: balance;
    padding-bottom: 0.08em;
  }
  .hero__lead {
    margin-top: 24px;
    max-width: 570px;
    font-size: clamp(1.25rem, 1rem + 1.1vw, 1.75rem);
    line-height: 1.4;
    font-weight: 450;
    letter-spacing: -0.012em;
    color: var(--text-2);
    text-wrap: pretty;
  }
  .hero__install {
    margin-top: 44px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero__label {
    margin-bottom: 12px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-3);
  }
  .hero__note {
    margin-top: 14px;
    font-size: 14px;
    color: var(--text-3);
  }
  .hero__note a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-left: 10px;
    font-weight: 600;
    white-space: nowrap;
  }
  .arrow {
    width: 16px;
    height: 16px;
    transition: transform 0.15s ease;
  }
  .hero__note a:hover .arrow {
    transform: translateX(2px);
  }
  .film {
    margin-top: clamp(56px, 7vw, 88px);
    width: 100%;
    max-width: 1080px;
  }
  .film__frame {
    position: relative;
    border-radius: var(--r-lg);
    padding: 8px;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-window);
  }
  video {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    background: #0e191f;
  }
  .film__play {
    position: absolute;
    inset: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    border: 0;
    border-radius: 10px;
    background: radial-gradient(40% 50% at 50% 50%, rgba(8, 18, 26, 0.18), transparent 70%);
    color: #fff;
    font: inherit;
    cursor: pointer;
  }
  .film__play[hidden] {
    display: none;
  }
  .film__playdisc {
    display: grid;
    place-items: center;
    width: clamp(64px, 8vw, 92px);
    height: clamp(64px, 8vw, 92px);
    border-radius: 50%;
    background: var(--p-fill);
    box-shadow: 0 0 0 10px rgba(255, 255, 255, 0.35), 0 18px 40px -10px rgba(15, 49, 70, 0.6);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }
  .film__playdisc .icon {
    width: 30px;
    height: 30px;
    fill: #fff;
    stroke: #fff;
    transform: translateX(2px);
  }
  .film__play:hover .film__playdisc {
    transform: scale(1.05);
    background: var(--p-fill-hover);
  }
  .film__playtext {
    display: inline-flex;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(8, 18, 26, 0.72);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
  }
  .film__playtext span {
    font-weight: 500;
    opacity: 0.75;
  }
  @media (max-width: 639px) {
    .film__playtext {
      display: none;
    }
  }
  .film__fallback {
    display: none;
    margin-top: 12px;
    font-size: 14px;
    color: var(--text-3);
  }
  .film:global(.is-failed) .film__fallback {
    display: block;
  }
</style>
