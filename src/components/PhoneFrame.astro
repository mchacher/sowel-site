---
import type { Img } from "../content/types";

interface Props {
  image: Img;
  /** The widest the device may be, in px. */
  max?: number;
  eager?: boolean;
}
const { image, max = 280, eager = false } = Astro.props;
---

<div class="device" style={`--max:${max}px`}>
  <div class="screen">
    <div class="status" aria-hidden="true">
      <span class="time">9:41</span>
      <span class="island"></span>
      <span class="icons">
        <svg viewBox="0 0 18 12" aria-hidden="true"><path d="M1 9h2.4v2H1zM5.2 6.5h2.4V11H5.2zM9.4 4h2.4v7H9.4zM13.6 1H16v10h-2.4z" fill="currentColor" /></svg>
        <svg viewBox="0 0 16 12" aria-hidden="true"><path d="M8 11.2 5.6 8.8a3.4 3.4 0 0 1 4.8 0zM3.9 7.1a6 6 0 0 1 8.2 0l-1.2 1.2a4.3 4.3 0 0 0-5.8 0zM1.6 4.8a9.2 9.2 0 0 1 12.8 0l-1.2 1.2a7.5 7.5 0 0 0-10.4 0z" fill="currentColor" /></svg>
        <svg viewBox="0 0 26 12" aria-hidden="true"><rect x=".5" y=".5" width="22" height="11" rx="3.2" fill="none" stroke="currentColor" opacity=".45" /><rect x="2" y="2" width="17" height="8" rx="2" fill="currentColor" /><rect x="23.6" y="4" width="1.8" height="4" rx=".9" fill="currentColor" opacity=".45" /></svg>
      </span>
    </div>
    <img
      src={image.src}
      alt={image.alt}
      width={image.width}
      height={image.height}
      loading={eager ? "eager" : "lazy"}
      decoding="async"
    />
    <div class="home" aria-hidden="true"><i></i></div>
  </div>
</div>

<style>
  /* A whole phone with its own status bar and home indicator, so no part of the app is
     ever cut by the rounded corners of the screen. The screenshot is a real 390 x 780
     capture taken at 3x: 47 px of status bar plus 780 plus 17 px of home indicator make
     the 390 x 844 screen of the device. Sizes are in cqw, so it scales as one piece. */
  .device {
    position: relative;
    width: 100%;
    max-width: var(--max);
    padding: 9px;
    border-radius: 46px;
    background: linear-gradient(160deg, #1c2830, #0b151b);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.1) inset,
      0 0 0 1.5px #050b0f,
      0 40px 70px -26px rgba(5, 11, 15, 0.55),
      0 14px 30px -14px rgba(5, 11, 15, 0.4);
  }
  .device::before {
    content: "";
    position: absolute;
    right: -3px;
    top: 22%;
    width: 3px;
    height: 12%;
    border-radius: 0 3px 3px 0;
    background: #0b151b;
  }
  .device::after {
    content: "";
    position: absolute;
    left: -3px;
    top: 18%;
    width: 3px;
    height: 7%;
    border-radius: 3px 0 0 3px;
    background: #0b151b;
    box-shadow: 0 34px 0 #0b151b, 0 66px 0 #0b151b;
  }
  .screen {
    container-type: inline-size;
    position: relative;
    overflow: hidden;
    border-radius: 37px;
    background: #ecf2f7;
  }
  .status {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 12.05cqw;
    padding: 1.5cqw 7.5cqw 0;
    background: #fff;
    color: #11171b;
    font-size: 4.1cqw;
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  .time {
    font-variant-numeric: tabular-nums;
  }
  .island {
    position: absolute;
    left: 50%;
    top: 2.6cqw;
    width: 29cqw;
    height: 8.2cqw;
    border-radius: 999px;
    background: #050b0f;
    transform: translateX(-50%);
  }
  .icons {
    display: flex;
    align-items: center;
    gap: 1.6cqw;
  }
  .icons svg {
    height: 3.1cqw;
    width: auto;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 390 / 780;
    object-fit: cover;
    object-position: top;
  }
  .home {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 4.36cqw;
    background: #ecf2f7;
  }
  .home i {
    display: block;
    width: 34cqw;
    height: 1.2cqw;
    border-radius: 999px;
    background: #11171b;
    opacity: 0.85;
  }
</style>
