---
// The schemes of an article drawn in HTML (spec 003): the topology of a home, the pipeline from devices to a recipe,
// a recipe's form and the closing layers. Each is one image (role="img") named by its label, in a figure on the soft
// well of the article's figures, with its caption. Every word comes from the article module; this file holds none.
import Icon from "./Icon.astro";
import type { Block } from "../content/articles/types";

type SchemeBlock = Extract<Block, { kind: "topology" | "pipeline" | "form" | "layers" }>;

interface Props {
  block: SchemeBlock;
  uid: string;
}
const { block: b, uid } = Astro.props;
const capId = `cap-${uid}`;
// The form's rows cut into sections at each group heading, so every <dl> holds only questions and answers.
type FormRow = Extract<SchemeBlock, { kind: "form" }>["rows"][number];
const sections: { group?: string; rows: { label: string; value: string }[] }[] = [];
if (b.kind === "form")
  for (const r of b.rows as FormRow[]) {
    if ("group" in r) sections.push({ group: r.group, rows: [] });
    else {
      if (!sections.length) sections.push({ rows: [] });
      sections[sections.length - 1].rows.push(r);
    }
  }
---

<figure class={`fig scheme scheme--${b.kind}`}>
  <div class="fig__well">
    {
      b.kind === "topology" && (
        <div class="topo" role="img" aria-label={b.label} aria-describedby={capId}>
          {b.zones.map((z) => (
            <div class={`topo__row topo__row--${z.level}`}>
              <span class="topo__name">
                <Icon name={z.icon} class="icon topo__ico" />
                {z.name}
              </span>
              <span class="topo__vals">
                {z.values.map((v) => (
                  <span class={v.on ? "v v--on" : "v"}>{v.text}</span>
                ))}
              </span>
            </div>
          ))}
        </div>
      )
    }
    {
      b.kind === "pipeline" && (
        <div class="pipe" role="img" aria-label={b.label} aria-describedby={capId}>
          {b.stages.map((st, n) => (
            <Fragment>
              {n > 0 && (
                <span class="pipe__link">
                  <Icon name="arrow-right" class="icon" />
                </span>
              )}
              <div class={st.accent ? "card card--accent" : "card"}>
                <div class="card__head">
                  <span class="card__ico">
                    <Icon name={st.icon} class="icon" />
                  </span>
                  <span>
                    <span class="card__name">{st.name}</span>
                    <span class="card__tag">{st.tag}</span>
                  </span>
                </div>
                <ul class={st.raw ? "rows rows--raw" : "rows"}>
                  {st.rows.map((r) => (
                    <li>
                      <span class="k">{r.key}</span>
                      <span class="val">{r.pill ? <span class={`pill pill--${r.pill}`}>{r.value}</span> : r.value}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </Fragment>
          ))}
        </div>
      )
    }
    {
      b.kind === "form" && (
        <div class="form" role="img" aria-label={b.label} aria-describedby={capId}>
          <div class="form__head">
            <Icon name="chef-hat" class="icon form__ico" />
            <span>
              <span class="form__title">{b.title}</span>
              <span class="form__sub">{b.subtitle}</span>
            </span>
          </div>
          <div class="form__rows">
            {sections.map((sec) => (
              <Fragment>
                {sec.group && <p class="form__group">{sec.group}</p>}
                <dl>
                  {sec.rows.map((r) => (
                    <div class="form__row">
                      <dt>{r.label}</dt>
                      <dd>{r.value}</dd>
                    </div>
                  ))}
                </dl>
              </Fragment>
            ))}
          </div>
        </div>
      )
    }
    {
      b.kind === "layers" && (
        <div class="layers" role="img" aria-label={b.label} aria-describedby={capId}>
          {b.items.map((it, n) => (
            <Fragment>
              {n > 0 && (
                <span class="pipe__link">
                  <Icon name={n === 1 ? "arrow-right" : "arrow-left-right"} class="icon" />
                </span>
              )}
              <div class={it.accent ? "card card--accent layer" : "card layer"}>
                <span class="card__ico">
                  <Icon name={it.icon} class="icon" />
                </span>
                <span class="layer__name">{it.name}</span>
                <span class="layer__body">{it.body}</span>
                <span class="layer__note">{it.note}</span>
              </div>
            </Fragment>
          ))}
        </div>
      )
    }
  </div>
  <figcaption id={capId}>{b.caption}</figcaption>
</figure>

<style>
  /* Shared: white cards on the soft well, a 2px accent outline on the one that matters, arrows between. */
  .card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-radius: 12px;
    background: var(--surface);
    box-shadow:
      0 0 0 1px var(--border),
      0 12px 28px -20px rgba(17, 23, 27, 0.4);
  }
  .card--accent {
    box-shadow:
      0 0 0 2px var(--accent-mark),
      0 12px 28px -20px rgba(17, 23, 27, 0.4);
  }
  .card__ico {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--p-50);
    color: var(--accent-ink);
  }
  .card__ico :global(.icon) {
    width: 17px;
    height: 17px;
  }
  .pipe__link {
    display: grid;
    place-items: center;
    color: var(--accent-mark);
  }
  .pipe__link :global(.icon) {
    width: 20px;
    height: 20px;
  }

  /* Topology: a tree of zones, each row with its name and the values computed for it. */
  .topo {
    display: grid;
    gap: 6px;
  }
  .topo__row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 12px;
    padding: 8px 12px;
    border-radius: 10px;
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--border);
  }
  .topo__row--0 {
    box-shadow: 0 0 0 2px var(--accent-mark);
  }
  .topo__row--1 {
    margin-left: 22px;
  }
  .topo__row--2 {
    margin-left: 44px;
  }
  .topo__row--1::before,
  .topo__row--2::before {
    content: "";
    position: absolute;
    left: -14px;
    top: 50%;
    width: 10px;
    border-top: 1px solid var(--border-strong);
  }
  .topo__name {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    font-weight: 650;
    color: var(--text-strong);
  }
  .topo__name :global(.topo__ico) {
    width: 16px;
    height: 16px;
    color: var(--accent-ink);
  }
  .topo__vals {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .v {
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--n-50);
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .v--on {
    background: var(--p-50);
    color: var(--accent-ink);
    font-weight: 600;
  }

  /* Pipeline: three cards joined by arrows; label above value, so a value never wraps beside its label. */
  .pipe {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 28px minmax(0, 1fr) 28px minmax(0, 1fr);
    align-items: stretch;
    gap: 6px;
  }
  .card__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--border);
  }
  .card__name {
    display: block;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--text-strong);
  }
  .card__tag {
    display: block;
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--text-3);
  }
  .rows {
    margin: 0;
    padding: 4px 14px 8px;
    list-style: none;
  }
  .rows li {
    display: grid;
    gap: 1px;
    padding: 8px 0;
    border-bottom: 1px dashed var(--border);
  }
  .rows li:last-child {
    border-bottom: 0;
  }
  .k {
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--text-3);
  }
  .val {
    font-size: 0.9rem;
    line-height: 1.35;
    font-weight: 600;
    color: var(--text-strong);
  }
  .rows--raw .k,
  .rows--raw .val {
    font-family: var(--mono);
  }
  .rows--raw .val {
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--text-2);
  }
  .pill {
    display: inline-block;
    padding: 1px 10px;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
  }
  .pill--room {
    background: var(--p-50);
    color: var(--accent-ink);
  }
  .pill--on {
    background: var(--active-bg);
    color: var(--active-ink);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--active) 55%, transparent);
  }

  /* Form: the recipe's questions and the example's answers, as the app's dialog shows them. */
  .form {
    max-width: 30rem;
    margin-inline: auto;
    overflow: hidden;
    border-radius: 14px;
    background: var(--surface);
    box-shadow:
      0 0 0 1px var(--border),
      0 18px 36px -20px rgba(17, 23, 27, 0.32);
  }
  .form__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
  }
  .form__head :global(.form__ico) {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--accent-ink);
  }
  .form__title {
    display: block;
    font-size: 0.95rem;
    font-weight: 650;
    line-height: 1.3;
    color: var(--text-strong);
  }
  .form__sub {
    display: block;
    font-size: 0.8rem;
    color: var(--text-3);
  }
  .form__rows {
    padding: 6px 16px 10px;
  }
  .form__rows dl {
    margin: 0;
  }
  .form__row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.85rem;
    line-height: 1.4;
  }
  .form__rows dl:last-child .form__row:last-child {
    border-bottom: 0;
  }
  .form__row dt {
    color: var(--text-2);
  }
  .form__row dd {
    margin: 0;
    font-weight: 550;
    text-align: right;
    color: var(--text-strong);
    font-variant-numeric: tabular-nums;
  }
  .form__group {
    margin: 0;
    padding: 12px 0 2px;
    font-size: 0.75rem;
    font-weight: 650;
    color: var(--text-3);
  }

  /* Layers: knowledge, then recipes, then the arbiter. */
  .layers {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 28px minmax(0, 1fr) 28px minmax(0, 1fr);
    align-items: stretch;
    gap: 6px;
  }
  .layer {
    gap: 4px;
    padding: 14px;
  }
  .layer .card__ico {
    margin-bottom: 4px;
  }
  .layer__name {
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--text-strong);
  }
  .layer__body {
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--text-2);
  }
  .layer__note {
    margin-top: auto;
    padding-top: 4px;
    font-size: 0.75rem;
    color: var(--text-3);
  }

  @media (max-width: 700px) {
    .pipe,
    .layers {
      grid-template-columns: minmax(0, 1fr);
    }
    .pipe__link {
      height: 24px;
    }
    .pipe__link :global(.icon) {
      transform: rotate(90deg);
    }
  }
  @media (max-width: 520px) {
    .topo__row--1 {
      margin-left: 12px;
    }
    .topo__row--2 {
      margin-left: 24px;
    }
    .topo__row--1::before,
    .topo__row--2::before {
      left: -8px;
      width: 6px;
    }
  }
</style>
