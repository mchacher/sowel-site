---
// The schemes of an article drawn in HTML (spec 003): the topology of a home, the pipeline from devices to a recipe,
// a recipe's form and the closing layers; spec 004 adds the layers of knowledge on examples, a propagation chain and
// the closing stack. Each is one image (role="img") named by its label, in a figure on the soft
// well of the article's figures, with its caption. Every word comes from the article module; this file holds none.
import Icon from "./Icon.astro";
import type { Block } from "../content/articles/types";

type SchemeBlock = Extract<Block, { kind: "topology" | "pipeline" | "form" | "layers" | "knowledge" | "chain" | "stack" }>;

interface Props {
  block: SchemeBlock;
  uid: string;
}
const { block: b, uid } = Astro.props;
const capId = `cap-${uid}`;
// The form's rows cut into sections at each group heading, so every <dl> holds only questions and answers.
type FormRow = Extract<SchemeBlock, { kind: "form" }>["rows"][number];
const sections: { group?: string; rows: { label: string; value: string }[] }[] = [];
if (b.kind === "form")
  for (const r of b.rows as FormRow[]) {
    if ("group" in r) sections.push({ group: r.group, rows: [] });
    else {
      if (!sections.length) sections.push({ rows: [] });
      sections[sections.length - 1].rows.push(r);
    }
  }
---

<figure class={`fig scheme scheme--${b.kind}`}>
  <div class="fig__well">
    {
      b.kind === "topology" && (
        <div class="topo" role="img" aria-label={b.label} aria-describedby={capId}>
          {b.zones.map((z) => (
            <div class={`topo__row topo__row--${z.level}`}>
              <span class="topo__name">
                <Icon name={z.icon} class="icon topo__ico" />
                {z.name}
              </span>
              <span class="topo__vals">
                {z.values.map((v) => (
                  <span class={v.on ? "v v--on" : "v"}>{v.text}</span>
                ))}
              </span>
            </div>
          ))}
        </div>
      )
    }
    {
      b.kind === "pipeline" && (
        <div class={`pipe pipe--${b.stages.length}`} role="img" aria-label={b.label} aria-describedby={capId}>
          {b.stages.map((st, n) => (
            <Fragment>
              {n > 0 && (
                <span class="pipe__link">
                  <Icon name="arrow-right" class="icon" />
                </span>
              )}
              <div class={st.accent ? "card card--accent" : "card"}>
                <div class="card__head">
                  <span class="card__ico">
                    <Icon name={st.icon} class="icon" />
                  </span>
                  <span>
                    <span class="card__name">{st.name}</span>
                    <span class="card__tag">{st.tag}</span>
                  </span>
                </div>
                <ul class={st.raw ? "rows rows--raw" : "rows"}>
                  {st.rows.map((r) => (
                    <li>
                      <span class="k">{r.key}</span>
                      <span class="val">{r.pill ? <span class={`pill pill--${r.pill}`}>{r.value}</span> : r.value}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </Fragment>
          ))}
        </div>
      )
    }
    {
      b.kind === "form" && (
        <div class="form" role="img" aria-label={b.label} aria-describedby={capId}>
          <div class="form__head">
            <Icon name="chef-hat" class="icon form__ico" />
            <span>
              <span class="form__title">{b.title}</span>
              <span class="form__sub">{b.subtitle}</span>
            </span>
          </div>
          <div class="form__rows">
            {sections.map((sec) => (
              <Fragment>
                {sec.group && <p class="form__group">{sec.group}</p>}
                <dl>
                  {sec.rows.map((r) => (
                    <div class="form__row">
                      <dt>{r.label}</dt>
                      <dd>{r.value}</dd>
                    </div>
                  ))}
                </dl>
              </Fragment>
            ))}
          </div>
        </div>
      )
    }
    {
      b.kind === "layers" && (
        <div class="layers" role="img" aria-label={b.label} aria-describedby={capId}>
          {b.items.map((it, n) => (
            <Fragment>
              {n > 0 && (
                <span class="pipe__link">
                  <Icon name={n === 1 ? "arrow-right" : "arrow-left-right"} class="icon" />
                </span>
              )}
              <div class={it.accent ? "card card--accent layer" : "card layer"}>
                <span class="card__ico">
                  <Icon name={it.icon} class="icon" />
                </span>
                <span class="layer__name">{it.name}</span>
                <span class="layer__body">{it.body}</span>
                <span class="layer__note">{it.note}</span>
              </div>
            </Fragment>
          ))}
        </div>
      )
    }
    {
      b.kind === "knowledge" && (
        <div class="km" role="img" aria-label={b.label} aria-describedby={capId} style={`--km-rows: ${b.rows.length}`}>
          {b.heads.map((hd, n) => (
            <Fragment>
              {n > 0 && <span class="km__gap" />}
              <span class={n === b.heads.length - 1 ? "km__head km__head--z" : "km__head"}>
                <span class="km__n">{hd.icon ? <Icon name={hd.icon} class="icon" /> : n}</span>
                <span>
                  <b>{hd.name}</b>
                  <i>{hd.tag}</i>
                </span>
              </span>
            </Fragment>
          ))}
          {b.rows.map((r) => (
            <div class="km__row">
              <span class="km__stack">
                {r.devices.map((d) => (
                  <span class="km__c km__c--raw">
                    {d.name}
                    <em>{d.raw}</em>
                  </span>
                ))}
              </span>
              <span class="km__a">
                <Icon name="arrow-right" class="icon" />
              </span>
              <span class="km__stack">
                {r.data.map((d) => (
                  <span class="km__c">
                    {d.name}
                    <em>{d.value}</em>
                  </span>
                ))}
              </span>
              <span class="km__a">
                <Icon name="arrow-right" class="icon" />
              </span>
              <span class="km__c km__c--eq">
                {r.equipment.name}
                <em>{r.equipment.tag}</em>
              </span>
            </div>
          ))}
          <div class="km__zones">
            <span class="km__a km__a--in" style={`grid-row: 1 / span ${b.zones.length + b.zones.filter((z) => z.tier === "above").length}`}>
              <Icon name="arrow-right" class="icon" />
            </span>
            {b.zones.map((z) => (
              <Fragment>
                {z.tier === "above" && (
                  <span class="km__up">
                    <Icon name="arrow-up" class="icon" />
                  </span>
                )}
                <span class={z.tier === "room" ? "km__zone km__zone--room" : "km__zone"}>
                  <span class="km__zname">
                    <Icon name={z.icon} class="icon" />
                    {z.name}
                  </span>
                  {z.values.map((v) => (
                    <span class={v.on ? "v v--on" : "v"}>{v.text}</span>
                  ))}
                </span>
              </Fragment>
            ))}
          </div>
        </div>
      )
    }
    {
      b.kind === "chain" && (
        <div class="chain" role="img" aria-label={b.label} aria-describedby={capId}>
          {b.steps.map((st, n) => (
            <Fragment>
              {n > 0 && (
                <span class="chain__arrow">
                  <Icon name="arrow-right" class="icon" />
                </span>
              )}
              <span class={st.accent ? "chain__step chain__step--accent" : "chain__step"}>
                <span class="card__ico">
                  <Icon name={st.icon} class="icon" />
                </span>
                <span class="chain__k">{st.key}</span>
                <span class="chain__v">{st.value}</span>
              </span>
            </Fragment>
          ))}
        </div>
      )
    }
    {
      b.kind === "stack" && (
        <div class="stack" role="img" aria-label={b.label} aria-describedby={capId}>
          <div class="stack__top">
            {b.items
              .filter((it) => it.tier === "use")
              .map((it) => (
                <span class="stack__use">
                  <span class="card__ico">
                    <Icon name={it.icon} class="icon" />
                  </span>
                  {it.name}
                </span>
              ))}
          </div>
          <div class="stack__base">
            <span class="stack__label">{b.base}</span>
            {b.items
              .filter((it) => it.tier === "layer")
              .map((it) => (
                <span class="stack__layer">
                  <span class="card__ico">
                    <Icon name={it.icon} class="icon" />
                  </span>
                  <span class="stack__name">{it.name}</span>
                  <span class="stack__desc">{it.body}</span>
                </span>
              ))}
          </div>
        </div>
      )
    }
  </div>
  <figcaption id={capId}>{b.caption}</figcaption>
</figure>

<style>
  /* Shared: white cards on the soft well, a 2px accent outline on the one that matters, arrows between. */
  .card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-radius: 12px;
    background: var(--surface);
    box-shadow:
      0 0 0 1px var(--border),
      0 12px 28px -20px rgba(17, 23, 27, 0.4);
  }
  .card--accent {
    box-shadow:
      0 0 0 2px var(--accent-mark),
      0 12px 28px -20px rgba(17, 23, 27, 0.4);
  }
  .card__ico {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--p-50);
    color: var(--accent-ink);
  }
  .card__ico :global(.icon) {
    width: 17px;
    height: 17px;
  }
  .pipe__link {
    display: grid;
    place-items: center;
    color: var(--accent-mark);
  }
  .pipe__link :global(.icon) {
    width: 20px;
    height: 20px;
  }

  /* Topology: a tree of zones, each row with its name and the values computed for it. */
  .topo {
    display: grid;
    gap: 6px;
  }
  .topo__row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 12px;
    padding: 8px 12px;
    border-radius: 10px;
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--border);
  }
  .topo__row--0 {
    box-shadow: 0 0 0 2px var(--accent-mark);
  }
  .topo__row--1 {
    margin-left: 22px;
  }
  .topo__row--2 {
    margin-left: 44px;
  }
  .topo__row--1::before,
  .topo__row--2::before {
    content: "";
    position: absolute;
    left: -14px;
    top: 50%;
    width: 10px;
    border-top: 1px solid var(--border-strong);
  }
  .topo__name {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    font-weight: 650;
    color: var(--text-strong);
  }
  .topo__name :global(.topo__ico) {
    width: 16px;
    height: 16px;
    color: var(--accent-ink);
  }
  .topo__vals {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .v {
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--n-50);
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .v--on {
    background: var(--p-50);
    color: var(--accent-ink);
    font-weight: 600;
  }

  /* Pipeline: three cards joined by arrows; label above value, so a value never wraps beside its label. */
  .pipe {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 28px minmax(0, 1fr) 28px minmax(0, 1fr);
    align-items: stretch;
    gap: 6px;
  }
  .card__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--border);
  }
  .card__name {
    display: block;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--text-strong);
  }
  .card__tag {
    display: block;
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--text-3);
  }
  .rows {
    margin: 0;
    padding: 4px 14px 8px;
    list-style: none;
  }
  .rows li {
    display: grid;
    gap: 1px;
    padding: 8px 0;
    border-bottom: 1px dashed var(--border);
  }
  .rows li:last-child {
    border-bottom: 0;
  }
  .k {
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--text-3);
  }
  .val {
    font-size: 0.9rem;
    line-height: 1.35;
    font-weight: 600;
    color: var(--text-strong);
  }
  .rows--raw .k,
  .rows--raw .val {
    font-family: var(--mono);
  }
  .rows--raw .val {
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--text-2);
  }
  .pill {
    display: inline-block;
    padding: 1px 10px;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
  }
  .pill--room {
    background: var(--p-50);
    color: var(--accent-ink);
  }
  .pill--on {
    background: var(--active-bg);
    color: var(--active-ink);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--active) 55%, transparent);
  }

  /* Form: the recipe's questions and the example's answers, as the app's dialog shows them. */
  .form {
    max-width: 30rem;
    margin-inline: auto;
    overflow: hidden;
    border-radius: 14px;
    background: var(--surface);
    box-shadow:
      0 0 0 1px var(--border),
      0 18px 36px -20px rgba(17, 23, 27, 0.32);
  }
  .form__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
  }
  .form__head :global(.form__ico) {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--accent-ink);
  }
  .form__title {
    display: block;
    font-size: 0.95rem;
    font-weight: 650;
    line-height: 1.3;
    color: var(--text-strong);
  }
  .form__sub {
    display: block;
    font-size: 0.8rem;
    color: var(--text-3);
  }
  .form__rows {
    padding: 6px 16px 10px;
  }
  .form__rows dl {
    margin: 0;
  }
  .form__row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.85rem;
    line-height: 1.4;
  }
  .form__rows dl:last-child .form__row:last-child {
    border-bottom: 0;
  }
  .form__row dt {
    color: var(--text-2);
  }
  .form__row dd {
    margin: 0;
    font-weight: 550;
    text-align: right;
    color: var(--text-strong);
    font-variant-numeric: tabular-nums;
  }
  .form__group {
    margin: 0;
    padding: 12px 0 2px;
    font-size: 0.75rem;
    font-weight: 650;
    color: var(--text-3);
  }

  /* Layers: knowledge, then recipes, then the arbiter. */
  .layers {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 28px minmax(0, 1fr) 28px minmax(0, 1fr);
    align-items: stretch;
    gap: 6px;
  }
  .layer {
    gap: 4px;
    padding: 14px;
  }
  .layer .card__ico {
    margin-bottom: 4px;
  }
  .layer__name {
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--text-strong);
  }
  .layer__body {
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--text-2);
  }
  .layer__note {
    margin-top: auto;
    padding-top: 4px;
    font-size: 0.75rem;
    color: var(--text-3);
  }

  .pipe--2 {
    grid-template-columns: minmax(0, 1fr) 28px minmax(0, 1fr);
  }
  .rows--raw .k {
    overflow-wrap: anywhere;
  }

  /* Knowledge (spec 004): devices, then data, then equipment, row by row; the zones to the right, the room outlined.
     The seven columns assume four heads (devices and the three layers). */
  .km {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18px minmax(0, 1fr) 18px minmax(0, 1fr) 18px minmax(0, 1.2fr);
    row-gap: 6px;
    align-items: stretch;
  }
  .km__head {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    padding-bottom: 4px;
  }
  .km__head b {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--text-strong);
  }
  .km__head i {
    display: block;
    font-style: normal;
    font-size: 0.72rem;
    line-height: 1.3;
    color: var(--text-3);
  }
  .km__n {
    display: grid;
    place-items: center;
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--p-50);
    color: var(--accent-ink);
    font-size: 0.72rem;
    font-weight: 700;
  }
  .km__n :global(.icon) {
    width: 13px;
    height: 13px;
  }
  .km__row {
    display: contents;
  }
  .km__row + .km__row > * {
    margin-top: 8px;
  }
  .km__stack {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .km__stack .km__c {
    flex: 1;
  }
  .km__c {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: 5px 9px;
    border-radius: 8px;
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--border);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text-strong);
    overflow-wrap: anywhere;
  }
  .km__c em {
    font-style: normal;
    font-weight: 400;
    font-size: 0.74rem;
    color: var(--text-2);
  }
  .km__c--raw {
    font-family: var(--mono);
    font-weight: 400;
    font-size: 0.72rem;
    color: var(--text-2);
  }
  .km__c--raw em {
    font-size: 0.7rem;
    color: var(--text-3);
  }
  .km__c--eq {
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent-mark) 45%, transparent);
  }
  .km__c--eq em {
    color: var(--text-3);
  }
  .km__a {
    display: grid;
    place-items: center;
    color: var(--accent-mark);
  }
  .km__a :global(.icon),
  .km__up :global(.icon) {
    width: 14px;
    height: 14px;
  }
  .km__zones {
    grid-column: 6 / 8;
    grid-row: 2 / span var(--km-rows);
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    align-content: center;
    row-gap: 4px;
  }
  .km__a--in {
    grid-column: 1;
    align-self: center;
  }
  .km__zone,
  .km__up {
    grid-column: 2;
  }
  .km__zone {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 5px;
    padding: 8px 10px;
    border-radius: 10px;
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--border);
  }
  .km__zone--room {
    box-shadow: 0 0 0 2px var(--accent-mark);
  }
  .km__zname {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    font-size: 0.85rem;
    font-weight: 650;
    color: var(--text-strong);
  }
  .km__zname :global(.icon) {
    flex: none;
    width: 15px;
    height: 15px;
    color: var(--accent-ink);
  }
  .km__up {
    display: grid;
    place-items: center;
    height: 18px;
    color: var(--accent-mark);
  }

  /* Chain (spec 004): one event climbing the layers, step by step. */
  .chain {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr) 22px;
    margin: 0;
    padding: 0;
    list-style: none;
    gap: 4px;
  }
  .chain__step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    min-width: 0;
    padding: 12px;
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--border);
  }
  .chain__step--accent {
    box-shadow: 0 0 0 2px var(--accent-mark);
  }
  .chain__step .card__ico {
    width: 30px;
    height: 30px;
  }
  .chain__step .card__ico :global(.icon) {
    width: 16px;
    height: 16px;
  }
  .chain__k {
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--text-3);
  }
  .chain__v {
    font-size: 0.86rem;
    line-height: 1.35;
    font-weight: 600;
    color: var(--text-strong);
  }
  .chain__arrow {
    display: grid;
    place-items: center;
    color: var(--accent-mark);
  }
  .chain__arrow :global(.icon) {
    width: 18px;
    height: 18px;
  }

  /* Stack (spec 004): the uses on top (four columns, one per use), the three layers of knowledge at the base. */
  .stack {
    display: grid;
    gap: 12px;
  }
  .stack__top {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }
  .stack__use {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    padding: 10px 12px;
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--border);
    font-size: 0.88rem;
    font-weight: 650;
    line-height: 1.25;
    color: var(--text-strong);
  }
  .stack .card__ico {
    width: 30px;
    height: 30px;
  }
  .stack .card__ico :global(.icon) {
    width: 16px;
    height: 16px;
  }
  .stack__base {
    display: grid;
    gap: 6px;
    padding: 12px;
    border-radius: 14px;
    box-shadow: 0 0 0 2px var(--accent-mark);
