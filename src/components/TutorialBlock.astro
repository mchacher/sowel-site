---
// The blocks of a tutorial (spec 005): items, a command, a file, a callout, a table, a screenshot.
import Icon from "./Icon.astro";
import Runs from "./Runs.astro";
import type { SiteCopy } from "../content/types";
import type { Block } from "../content/articles/types";

type TutorialKind = "items" | "code" | "file" | "callout" | "table" | "shot";
interface Props {
  copy: SiteCopy;
  block: Extract<Block, { kind: TutorialKind }>;
  eager?: boolean;
}
const { copy, block: b, eager } = Astro.props;
const tp = copy.tutorialPage;
const calloutIcon = { tip: "lightbulb", warn: "triangle-alert", note: "info" } as const;
---

{
  b.kind === "items" &&
    (b.ordered ? (
      <ol class="t-block t-steps">{b.items.map((it) => <li><Runs runs={it} /></li>)}</ol>
    ) : (
      <ul class="t-block t-list">{b.items.map((it) => <li><Runs runs={it} /></li>)}</ul>
    ))
}
{
  (b.kind === "code" || b.kind === "file") && (
    <div class={`t-block term term--${b.kind}`}>
      <div class="term__bar">
        {b.kind === "file" ? (
          <span class="term__name"><Icon name="file-code" class="icon term__i" />{b.name}</span>
        ) : (
          <span class="term__name"><Icon name="terminal" class="icon term__i" /></span>
        )}
        <button class="term__btn" type="button" data-copy={b.kind === "code" ? b.cmd : b.content} data-idle={tp.copy} data-done={tp.copied}>
          <Icon name="copy" class="icon term__i term__i--copy" />
          <Icon name="check" class="icon term__i term__i--done" />
          <span data-copy-label>{tp.copy}</span>
        </button>
      </div>
      {b.kind === "code" ? (
        <>
          <pre class="term__cmd" tabindex="0">{b.cmd.split("\n").map((l) => <span class="term__line">{l}</span>)}</pre>
          {b.output && <pre class="term__out" tabindex="0">{b.output}</pre>}
        </>
      ) : (
        <pre class="term__file" tabindex="0">{b.content}</pre>
      )}
    </div>
  )
}
{
  b.kind === "callout" && (
    <aside class={`t-block callout callout--${b.tone}`}>
      <p class="callout__head">
        <Icon name={calloutIcon[b.tone]} class="icon callout__i" />
        <span class="callout__tag">{tp.callout[b.tone]}</span>
        <span class="callout__title">{b.title}</span>
      </p>
      <p><Runs runs={b.runs} /></p>
    </aside>
  )
}
{
  b.kind === "table" && (
    <div class="t-block t-table" tabindex="0">
      <table>
        <thead><tr>{b.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
        <tbody>{b.rows.map((r) => <tr>{r.map((c) => <td><Runs runs={c} /></td>)}</tr>)}</tbody>
      </table>
    </div>
  )
}
{
  b.kind === "shot" && (
    <figure class="t-block shot">
      <img src={b.image.src} alt={b.image.alt} width={b.image.width} height={b.image.height} decoding="async" loading={eager ? "eager" : "lazy"} style={`max-width:min(100%, ${Math.round(b.image.width / 2)}px)`} />
      <figcaption>{b.caption}</figcaption>
    </figure>
  )
}

<style>
  .t-block :global(strong) {
    font-weight: 650;
    color: var(--text-strong);
  }
  .t-block :not(pre) > :global(code) {
    font-family: var(--mono);
    font-size: 0.82em;
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--n-50);
    color: var(--text-2);
    overflow-wrap: anywhere;
  }
  .t-list {
    display: grid;
    gap: 0.55em;
  }
  .t-list li {
    position: relative;
    padding-left: 1.6em;
  }
  .t-list li::before {
    content: "";
    position: absolute;
    left: 0.3em;
    top: 0.72em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-mark);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-mark) 18%, transparent);
  }
  .t-steps {
    counter-reset: step;
    list-style: none;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .t-steps li {
    counter-increment: step;
    position: relative;
    padding-left: 44px;
  }
  .t-steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0.1em;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 0.85rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--accent-ink);
    background: var(--p-50);
    box-shadow: 0 0 0 1px var(--p-100) inset;
  }
  .term {
    margin-block: 1.4rem;
    border-radius: var(--r-md);
    background: var(--code-bg);
    overflow: hidden;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.06) inset, 0 12px 28px -16px rgba(15, 49, 70, 0.5);
  }
  .term__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 6px 8px 6px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .term__name {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 500 0.8rem/1 var(--mono);
    color: var(--code-dim);
  }
  .term :global(.term__i) {
    width: 15px;
    height: 15px;
  }
  .term__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--r-sm);
    background: transparent;
    color: var(--code-text);
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1;
    cursor: pointer;
  }
  .term__btn:hover {
    background: rgba(255, 255, 255, 0.06);
  }
  .term__btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .term :global(.term__i--done),
  .term__btn:global(.is-done) :global(.term__i--copy) {
    display: none;
  }
  .term__btn:global(.is-done) :global(.term__i--done) {
    display: inline;
  }
  .term pre {
    margin: 0;
    padding: 14px 16px;
    font: 0.875rem/1.65 var(--mono);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .term__cmd {
    color: var(--code-text);
  }
  .term__line {
    display: block;
  }
  .term__line::before {
    content: "$ " / "";
    color: var(--code-dim);
  }
  .term__out {
    color: #9fb4c1;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }
  .term__file {
    color: var(--code-text);
  }
  .callout {
    margin-block: 1.6rem;
    padding: 16px 20px;
    border-radius: var(--r-md);
    border: 1px solid var(--border);
    background: var(--surface-sunk);
  }
  .callout p {
    margin: 0;
  }
  .callout p + p {
    margin-top: 6px;
  }
  .callout__head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-weight: 600;
    color: var(--text-strong);
  }
  .callout :global(.callout__i) {
    width: 18px;
    height: 18px;
  }
  .callout__tag {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .callout--tip {
    background: var(--p-50);
    border-color: var(--p-100);
  }
  .callout--tip .callout__head {
    color: var(--accent-ink);
  }
  .callout--tip .callout__title,
  .callout--warn .callout__title {
    color: var(--text-strong);
  }
  .callout--warn {
    background: #fff4e5;
    border-color: #f5d9ad;
  }
  .callout--warn .callout__head {
    color: #8a4b00;
  }
  .callout--note .callout__head {
    color: var(--text-2);
  }
  .t-table {
    margin-block: 1.4rem;
    overflow-x: auto;
  }
  .t-table table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .t-table th,
  .t-table td {
    text-align: left;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .t-table th {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .shot {
    margin-block: 2rem;
    text-align: center;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    margin-inline: auto;
    border-radius: var(--r-md);
    box-shadow: 0 0 0 1px var(--border), 0 18px 36px -20px rgba(17, 23, 27, 0.32);
    filter: var(--img-dim);
  }
  .shot figcaption {
    margin-top: 10px;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-3);
  }
</style>
