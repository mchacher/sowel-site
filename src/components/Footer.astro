---
import type { SiteCopy } from "../content/types";
import Logo from "./Logo.astro";

interface Props {
  copy: SiteCopy;
}
const { footer } = Astro.props.copy;
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <Logo size={28} />
      <div>
        <p class="footer__tag">{footer.tagline}</p>
        <p class="footer__small">{footer.licence}</p>
      </div>
    </div>
    <nav class="footer__links">
      {footer.links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
  <div class="container">
    <p class="footer__privacy">{footer.privacy}</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: 48px 40px;
    border-top: 1px solid var(--border);
    background: var(--bg-band);
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .footer__brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .footer__tag {
    font-weight: 650;
    color: var(--text-strong);
  }
  .footer__small {
    font-size: 14px;
    color: var(--text-3);
  }
  .footer__links {
    display: flex;
    gap: 24px;
    font-size: 15px;
    font-weight: 500;
  }
  .footer__links a {
    color: var(--text-2);
  }
  .footer__links a:hover {
    color: var(--p-500);
  }
  .footer__privacy {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: 13px;
    color: var(--text-3);
  }
</style>
