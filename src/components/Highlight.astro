---
// A highlight of an article (spec 002): a sentence in a card, its key words in the accent ink, and a diagram under
// it. The diagram is inline SVG drawn from CSS variables (both themes, no request, no script): one hub joined to the
// appliances, each driven by a recipe. Two layouts, the card's width picks one: a row of appliances under the hub,
// or a column of them hanging from a trunk on a phone. Every label comes from the article's content module.
import Icon from "./Icon.astro";
import type { Block } from "../content/articles/types";

interface Props {
  block: Extract<Block, { kind: "highlight" }>;
  /** Unique within the page, for the ids of the diagram's title and description. */
  uid: string;
}
const { block, uid } = Astro.props;
const il = block.illustration;
const at = block.text.indexOf(block.accent);
const before = at < 0 ? block.text : block.text.slice(0, at);
const after = at < 0 ? "" : block.text.slice(at + block.accent.length);

// Wide layout: the hub on top, the appliances in a row under it, a line from the hub to each recipe chip.
const W = { w: 722, h: 296, card: 220, gap: 30, cardY: 174, chipY: 162, cardH: 120 };
const wide = il.loads.map((l, n) => {
  const x = 1 + n * (W.card + W.gap);
  return { ...l, x, cx: x + W.card / 2 };
});
const hubX = 361;
const wire = (cx: number) =>
  cx === hubX
    ? `M${hubX} 82 V${W.chipY}`
    : `M${hubX} 82 V106 Q${hubX} 120 ${hubX + (cx > hubX ? 14 : -14)} 120 H${cx + (cx > hubX ? -14 : 14)} Q${cx} 120 ${cx} 134 V${W.chipY}`;

// Narrow layout: the hub on top, a trunk down the left, each appliance on a branch of it.
const N = { w: 340, trunk: 38, cardX: 54, chipX: 68, first: 110, step: 122, cardH: 88 };
const narrow = il.loads.map((l, n) => ({ ...l, top: N.first + n * N.step }));
const last = narrow.at(-1)?.top ?? N.first;
const nH = last + N.cardH + 4;
const ids = (k: string) => ({ title: `${uid}-${k}-t`, desc: `${uid}-${k}-d` });
const wi = ids("w");
const ni = ids("n");
---

<div class="hl">
  <p class="hl__text">{before}<strong class="hl__accent">{block.accent}</strong>{after}</p>
  <div class="hl__fig">
    <svg
      class="hl__svg hl__svg--wide"
      viewBox={`0 0 ${W.w} ${W.h}`}
      role="img"
      aria-labelledby={wi.title}
      aria-describedby={wi.desc}
    >
      <title id={wi.title}>{il.title}</title>
      <desc id={wi.desc}>{il.desc}</desc>
      <g class="hl__wires">
        {wide.map((l) => <path class="hl__wire" d={wire(l.cx)} pathLength="1" />)}
      </g>
      <g class="hl__hub">
        <rect x={hubX - 160} y="6" width="320" height="76" rx="16" />
        <circle class="hl__hub-ring" cx={hubX - 120} cy="44" r="23" />
        <Icon name={il.hub.icon} class="hl__ico hl__ico--hub" x={hubX - 133} y="31" width="26" height="26" />
        <text class="hl__hub-name" x={hubX - 84} y="39">{il.hub.name}</text>
        <text class="hl__hub-tag" x={hubX - 84} y="63">{il.hub.tag}</text>
      </g>
      {
        wide.map((l) => (
          <g class="hl__load">
            <rect class="hl__card" x={l.x} y={W.cardY} width={W.card} height={W.cardH} rx="12" />
            <circle class="hl__ring" cx={l.cx} cy={W.cardY + 46} r="20" />
            <Icon name={l.icon} class="hl__ico" x={l.cx - 11} y={W.cardY + 35} width="22" height="22" />
            <text class="hl__name" x={l.cx} y={W.cardY + 88} text-anchor="middle">{l.name}</text>
            <text class="hl__tag" x={l.cx} y={W.cardY + 108} text-anchor="middle">{il.loadTag}</text>
            <rect class="hl__chip" x={l.cx - 50} y={W.chipY} width="100" height="25" rx="12.5" />
            <Icon name="chef-hat" class="hl__ico hl__ico--chip" x={l.cx - 38} y={W.chipY + 5} width="15" height="15" />
            <text class="hl__chip-label" x={l.cx - 18} y={W.chipY + 17.5}>{il.recipe}</text>
          </g>
        ))
      }
    </svg>

    <svg
      class="hl__svg hl__svg--narrow"
      viewBox={`0 0 ${N.w} ${nH}`}
      role="img"
      aria-labelledby={ni.title}
      aria-describedby={ni.desc}
    >
      <title id={ni.title}>{il.title}</title>
      <desc id={ni.desc}>{il.desc}</desc>
      <g class="hl__wires">
        <path class="hl__wire" d={`M${N.trunk} 80 V${last - 12} Q${N.trunk} ${last} ${N.trunk + 12} ${last} H${N.chipX}`} pathLength="1" />
        {narrow.slice(0, -1).map((l) => <path class="hl__wire" d={`M${N.trunk} ${l.top} H${N.chipX}`} pathLength="1" />)}
      </g>
      <g class="hl__hub">
        <rect x="0" y="4" width={N.w} height="76" rx="16" />
        <circle class="hl__hub-ring" cx={N.trunk} cy="42" r="22" />
        <Icon name={il.hub.icon} class="hl__ico hl__ico--hub" x={N.trunk - 12} y="30" width="24" height="24" />
        <text class="hl__hub-name" x="76" y="37">{il.hub.name}</text>
        <text class="hl__hub-tag" x="76" y="61">{il.hub.tag}</text>
      </g>
      {
        narrow.map((l) => (
          <g class="hl__load">
            <rect class="hl__card" x={N.cardX} y={l.top} width={N.w - N.cardX - 1} height={N.cardH} rx="12" />
            <circle class="hl__ring" cx={N.cardX + 32} cy={l.top + 50} r="19" />
            <Icon name={l.icon} class="hl__ico" x={N.cardX + 21} y={l.top + 39} width="22" height="22" />
            <text class="hl__name" x={N.cardX + 64} y={l.top + 47}>{l.name}</text>
            <text class="hl__tag" x={N.cardX + 64} y={l.top + 69}>{il.loadTag}</text>
            <rect class="hl__chip" x={N.chipX} y={l.top - 12.5} width="100" height="25" rx="12.5" />
            <Icon name="chef-hat" class="hl__ico hl__ico--chip" x={N.chipX + 12} y={l.top - 7.5} width="15" height="15" />
            <text class="hl__chip-label" x={N.chipX + 32} y={l.top + 5}>{il.recipe}</text>
          </g>
        ))
      }
    </svg>
  </div>
</div>

<style>
  /* The card: the soft well of the figures, an accent rule along the sentence (its width is set by the article). */
  .hl {
    container-type: inline-size;
    padding: clamp(16px, 3vw, 30px);
    border-radius: var(--r-lg);
    border: 1px solid var(--border);
    background:
      radial-gradient(75% 60% at 50% 100%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 72%),
      var(--n-50);
  }
  .hl__text {
    padding-left: clamp(14px, 2.4vw, 20px);
    border-left: 3px solid var(--accent-mark);
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--text-strong);
    text-wrap: pretty;
  }
  .hl .hl__accent {
    font-weight: 650;
    color: var(--accent-ink);
  }
  .hl__fig {
    margin-top: clamp(20px, 3vw, 28px);
  }

  .hl__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font);
  }
  .hl__svg--wide {
    display: none;
  }
  .hl__svg--narrow {
    max-width: 26rem;
    margin-inline: auto;
  }
  @container (min-width: 600px) {
    .hl__svg--wide {
      display: block;
    }
    .hl__svg--narrow {
      display: none;
    }
  }

  .hl__wire {
    fill: none;
    stroke: var(--accent-mark);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.75;
  }
  .hl__hub rect {
    fill: var(--tile);
  }
  .hl__hub-ring {
    fill: var(--tile-line);
  }
  .hl__hub-name {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.01em;
    fill: var(--tile-text);
  }
  .hl__hub-tag {
    font-size: 14px;
    font-weight: 500;
    fill: var(--tile-text-2);
  }
  .hl__card {
    fill: var(--surface);
    stroke: var(--border-strong);
    stroke-width: 1;
  }
  .hl__ring {
    fill: var(--p-50);
  }
  .hl__name {
    font-size: 16px;
    font-weight: 650;
    fill: var(--text-strong);
  }
  .hl__tag {
    font-size: 13.5px;
    font-weight: 500;
    fill: var(--text-2);
  }
  .hl__chip {
    fill: var(--p-50);
    stroke: color-mix(in srgb, var(--accent-mark) 55%, transparent);
    stroke-width: 1;
  }
  .hl__chip-label {
    font-size: 13.5px;
    font-weight: 600;
    fill: var(--accent-ink);
  }
  .hl :global(.hl__ico) {
    fill: none;
    stroke: var(--accent-ink);
  }
  .hl :global(.hl__ico--hub) {
    stroke: var(--tile-text);
  }

  /* A one-shot draw of the wires, none under reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .hl__wire {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: hl-draw 0.9s 0.25s ease-out forwards;
    }
  }
  @keyframes hl-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
