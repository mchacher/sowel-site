---
// The master-weight logo from the core (docs/assets/logo-master.svg), inlined so it follows the theme.
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<svg class="logo" width={size} height={size} viewBox="20 10 160 165" fill="none" aria-hidden="true">
  <path
    d="M100 30 L160 90 Q165 95 160 100 L160 150 Q160 158 152 158 L48 158 Q40 158 40 150 L40 100 Q35 95 40 90 Z"
    stroke="var(--p-500)"
    stroke-width="9"
    stroke-linejoin="round"
    stroke-linecap="round"></path>
  <path d="M72 114 Q100 142 128 114" stroke="var(--p-mid)" stroke-width="7.5" stroke-linecap="round"></path>
  <path d="M75 94 Q81 84 87 94" stroke="var(--p-mid)" stroke-width="7" stroke-linecap="round"></path>
  <path d="M113 94 Q119 84 125 94" stroke="var(--p-mid)" stroke-width="7" stroke-linecap="round"></path>
</svg>
