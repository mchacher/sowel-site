---
import type { SiteCopy } from "../content/types";
import Icon from "./Icon.astro";
import Accent from "./Accent.astro";
import SectionTag from "./SectionTag.astro";

interface Props {
  copy: SiteCopy;
}
const { rooms } = Astro.props.copy;
---

<section class="section section--band" id={rooms.id}>
  <div class="container rooms">
    <div class="rooms__text">
      <div class="section-head" data-reveal>
        <SectionTag text={rooms.eyebrow} icon="layout-grid" />
        <h2 class="h2"><Accent text={rooms.title} accent={rooms.titleAccent} /></h2>
        <p class="lead">{rooms.lead}</p>
      </div>
      <ul class="facts">
        {
          rooms.items.map((it, i) => (
            <li class="fact" data-reveal style={`--delay:${i * 60}ms`}>
              <span class="fact__tile">
                <Icon name={it.icon} class="icon" />
              </span>
              <span>
                <strong>{it.title}</strong>
                <span>{it.body}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="bento">
      <figure class="card card--strip" data-reveal>
        <span class="tag"><span class="tag__dot"></span>{rooms.stripCaption}</span>
        <img class="strip" src={rooms.stripSmall.src} alt={rooms.stripSmall.alt} width={rooms.stripSmall.width} height={rooms.stripSmall.height} loading="lazy" decoding="async" />
      </figure>

      <figure class="card card--activity" data-reveal style="--delay:80ms">
        <span class="tag"><span class="tag__dot"></span>{rooms.activity.caption}</span>
        <img class="activity" src={rooms.activity.image.src} alt={rooms.activity.image.alt} width={rooms.activity.image.width} height={rooms.activity.image.height} loading="lazy" decoding="async" />
      </figure>
    </div>
  </div>
</section>

<style>
  .rooms {
    display: grid;
    gap: clamp(48px, 6vw, 72px);
  }
  @media (min-width: 1024px) {
    .rooms {
      grid-template-columns: 5fr 7fr;
      gap: 64px;
      align-items: start;
    }
    .rooms__text {
      position: sticky;
      top: 120px;
    }
  }
  .facts {
    margin-top: 40px;
    display: grid;
    gap: 4px;
  }
  .fact {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 14px 0;
    border-top: 1px solid var(--border);
  }
  .fact:last-child {
    border-bottom: 1px solid var(--border);
  }
  .fact__tile {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: var(--r-md);
    background: var(--p-50);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    color: var(--accent-ink);
  }
  .fact > span:last-child {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-2);
  }
  .fact strong {
    font-weight: 600;
    color: var(--text-strong);
  }

  .bento {
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .bento {
      gap: 20px;
    }
  }
  .card {
    position: relative;
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .card img {
    filter: var(--img-dim);
  }
  .card--strip {
    background: var(--n-50);
  }
  .card--strip {
    display: flex;
    justify-content: center;
    padding: 64px 16px 0;
  }
  .card--strip img {
    width: 100%;
    max-width: 640px;
    border-radius: 10px 10px 0 0;
    box-shadow: 0 0 0 1px var(--border), 0 18px 40px -18px rgba(17, 23, 27, 0.25);
  }
  .card--activity {
    display: flex;
    justify-content: center;
    padding: 64px 16px 0;
    background: var(--n-50);
    max-height: 560px;
  }
  .card--activity img {
    width: 100%;
    max-width: 440px;
    align-self: flex-start;
    border-radius: 10px 10px 0 0;
    box-shadow: 0 0 0 1px var(--border), 0 18px 40px -18px rgba(17, 23, 27, 0.25);
  }
  .tag {
    position: absolute;
    top: 16px;
    left: 16px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-2);
  }
  .tag__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-mark);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-mark) 20%, transparent);
  }
</style>
