---
import type { SiteCopy } from "../content/types";
import Icon from "./Icon.astro";

interface Props {
  copy: SiteCopy;
}
const { rooms } = Astro.props.copy;
---

<section class="section section--band" id={rooms.id}>
  <div class="container rooms">
    <div class="rooms__text">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{rooms.eyebrow}</p>
        <h2 class="h2">{rooms.title}</h2>
        <p class="lead">{rooms.lead}</p>
      </div>
      <ul class="facts">
        {
          rooms.items.map((it, i) => (
            <li class="fact" data-reveal style={`--delay:${i * 60}ms`}>
              <span class="fact__tile">
                <Icon name={it.icon} class="icon" />
              </span>
              <span>
                <strong>{it.title}</strong>
                <span>{it.body}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="bento">
      <figure class="card card--strip" data-reveal>
        <span class="tag"><span class="tag__dot"></span>{rooms.stripCaption}</span>
        <img class="strip" src={rooms.stripSmall.src} alt={rooms.stripSmall.alt} width={rooms.stripSmall.width} height={rooms.stripSmall.height} loading="lazy" decoding="async" />
      </figure>

      <figure class="card card--phone" data-reveal style="--delay:80ms">
        <div class="phone">
          <img src={rooms.phone.src} alt={rooms.phone.alt} width={rooms.phone.width} height={rooms.phone.height} loading="lazy" decoding="async" />
        </div>
      </figure>

      <div class="card card--modes" data-reveal style="--delay:160ms">
        <img src={rooms.modes.image.src} alt={rooms.modes.image.alt} width={rooms.modes.image.width} height={rooms.modes.image.height} loading="lazy" decoding="async" />
        <div class="modes__text">
          <h3>{rooms.modes.title}</h3>
          <p>{rooms.modes.body}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .rooms {
    display: grid;
    gap: clamp(48px, 6vw, 72px);
  }
  @media (min-width: 1024px) {
    .rooms {
      grid-template-columns: 5fr 7fr;
      gap: 64px;
      align-items: start;
    }
    .rooms__text {
      position: sticky;
      top: 120px;
    }
  }
  .facts {
    margin-top: 40px;
    display: grid;
    gap: 4px;
  }
  .fact {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 14px 0;
    border-top: 1px solid var(--border);
  }
  .fact:last-child {
    border-bottom: 1px solid var(--border);
  }
  .fact__tile {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: var(--r-md);
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--p-500);
  }
  .fact > span:last-child {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-2);
  }
  .fact strong {
    font-weight: 600;
    color: var(--text-strong);
  }

  .bento {
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .bento {
      grid-template-columns: 5fr 6fr;
      gap: 20px;
    }
    .card--strip {
      grid-column: 1 / -1;
    }
  }
  .card {
    position: relative;
    border-radius: var(--r-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .card img {
    filter: var(--img-dim);
  }
  .card--strip {
    background: var(--n-50);
  }
  .card--strip {
    display: flex;
    justify-content: center;
    padding: 64px 16px 0;
  }
  .card--strip img {
    width: 100%;
    max-width: 640px;
    border-radius: 10px 10px 0 0;
    box-shadow: 0 0 0 1px var(--border), 0 18px 40px -18px rgba(17, 23, 27, 0.25);
  }
  .tag {
    position: absolute;
    top: 16px;
    left: 16px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-2);
  }
  .tag__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--success) 18%, transparent);
  }
  .card--phone {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 32px 24px 0;
    background:
      radial-gradient(80% 60% at 50% 100%, var(--glow), transparent 70%),
      var(--surface);
    height: 520px;
  }
  .phone {
    width: 100%;
    max-width: 268px;
    border-radius: 40px 40px 0 0;
    padding: 10px 10px 0;
    background: #11171b;
    box-shadow: 0 30px 60px -20px rgba(17, 23, 27, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.06) inset;
  }
  .phone img {
    border-radius: 31px 31px 0 0;
    width: 100%;
  }
  .card--modes {
    display: flex;
    flex-direction: column;
    background: var(--n-50);
  }
  .card--modes img {
    width: 100%;
    max-width: 420px;
    margin: 24px auto 0;
    width: calc(100% - 32px);
    border-radius: 10px;
    box-shadow: 0 0 0 1px var(--border);
  }
  .modes__text {
    margin-top: auto;
    padding: 24px 24px 28px;
    background: var(--surface);
    border-top: 1px solid var(--border);
  }
  .modes__text h3 {
    font-size: 19px;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--text-strong);
  }
  .modes__text p {
    margin-top: 8px;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--text-2);
  }
</style>
