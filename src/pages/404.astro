---
import { withBase } from "../lib/url";
// A plain page in both languages: no copy file entry, because it is not part of the showcase page.
const home = { en: withBase("/en/"), fr: withBase("/fr/") };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; style-src 'unsafe-inline'; img-src 'self'; base-uri 'self'; form-action 'none'" />
    <title>Sowel: page not found</title>
    <link rel="icon" href={withBase("/img/logo.svg")} type="image/svg+xml" />
    <style>
      :root { color-scheme: light dark; }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; text-align: center; padding: 24px;
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif; background: #0b151b; color: #f3f7fa; }
      img { width: 56px; height: 56px; }
      h1 { margin: 20px 0 6px; font-size: clamp(1.8rem, 5vw, 2.6rem); letter-spacing: -0.03em; }
      p { margin: 0 0 22px; color: #a9c3d3; }
      a { display: inline-block; margin: 0 6px; padding: 10px 18px; border-radius: 999px; background: #2b7299; color: #fff;
        font-weight: 600; text-decoration: none; }
      a:focus-visible { outline: 3px solid #7fb8d4; outline-offset: 2px; }
    </style>
  </head>
  <body>
    <main>
      <img src={withBase("/img/logo-night.svg")} alt="" width="56" height="56" />
      <h1>This page does not exist.</h1>
      <p lang="fr">Cette page n'existe pas.</p>
      <a href={home.en} hreflang="en" lang="en">Sowel in English</a>
      <a href={home.fr} hreflang="fr" lang="fr">Sowel en français</a>
    </main>
  </body>
</html>
