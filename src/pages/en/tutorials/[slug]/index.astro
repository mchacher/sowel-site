---
import ArticlePage from "../../../../components/ArticlePage.astro";
import { en } from "../../../../content/en";
import { tutorials, slugOf } from "../../../../content/tutorials/index.ts";
import type { Article } from "../../../../content/articles/types";

// One page per tutorial (spec 005), at /en/tutorials/<slug>/.
export function getStaticPaths() {
  return tutorials.map((t) => ({ params: { slug: slugOf(t.en) }, props: { article: t.en } }));
}
interface Props {
  article: Article;
}
const { article } = Astro.props;
---

<ArticlePage copy={en} article={article} />
