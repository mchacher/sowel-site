---
import ArticlePage from "../../../../components/ArticlePage.astro";
import { en } from "../../../../content/en";
import { articles, slugOf } from "../../../../content/articles/index.ts";
import type { Article } from "../../../../content/articles/types";

// One page per article of the registry (spec 002), at /en/articles/<slug>/.
export function getStaticPaths() {
  return articles.map((entry) => ({ params: { slug: slugOf(entry.en) }, props: { article: entry.en } }));
}
interface Props {
  article: Article;
}
const { article } = Astro.props;
---

<ArticlePage copy={en} article={article} />
