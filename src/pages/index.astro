---
// Language picker: French when the browser says fr, English otherwise. No cookie, no storage.
import { withBase } from "../lib/url";
const languages = [
  { href: withBase("/en/"), label: "English", lang: "en" },
  { href: withBase("/fr/"), label: "Français", lang: "fr" },
];
const go = { en: withBase("/en/"), fr: withBase("/fr/") };
// Search engines want absolute addresses: the canonical and the alternates point at the real pages.
const abs = (path: string) => new URL(path, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'unsafe-inline'; style-src 'unsafe-inline'" />
    <title>Sowel: home automation that looks after your home</title>
    <meta name="description" content="Sowel looks after your home. Open source home automation on your own hardware. English and French." />
    <link rel="canonical" href={abs(go.en)} />
    <link rel="alternate" hreflang="en" href={abs(go.en)} />
    <link rel="alternate" hreflang="fr" href={abs(go.fr)} />
    <link rel="alternate" hreflang="x-default" href={abs(go.en)} />
    <script is:inline define:vars={{ go }}>
      location.replace(/^fr\b/i.test(navigator.language || "") ? go.fr : go.en);
    </script>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        font-family: system-ui, sans-serif;
        background: #ffffff;
        color: #21282d;
      }
      a {
        color: #1a4f6e;
        margin: 0 12px;
        font-weight: 600;
      }
      @media (prefers-color-scheme: dark) {
        body {
          background: #0b151b;
          color: #e4e8eb;
        }
        a {
          color: #5ba5cc;
        }
      }
    </style>
  </head>
  <body>
    <noscript>
      <p>{languages.map((l) => <a href={l.href} lang={l.lang}>{l.label}</a>)}</p>
    </noscript>
  </body>
</html>
